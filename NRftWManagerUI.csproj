<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RiftCtrl</AssemblyName>
    <Product>RIFT//CTRL</Product>
    <ApplicationIcon>Assets\riftctrl.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\riftctrl-icon.png" />
    <Resource Include="Assets\riftctrl.ico" />
  </ItemGroup>
</Project>
