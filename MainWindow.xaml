<Window x:Class="NRftWManagerUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NRftW Manager" Height="860" Width="1380" MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="218" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#101824" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Margin="6,8,6,24">
            <TextBlock Text="NRftW" FontSize="23" FontWeight="Bold" />
            <TextBlock Text="Item Manager" FontSize="13" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
          <Button Style="{StaticResource NavButton}" Tag="overview" Click="OnNavigate" Content="概览" />
          <Button Style="{StaticResource NavButton}" Tag="items" Click="OnNavigate" Content="物品数量" />
          <Button Style="{StaticResource NavButton}" Tag="equipment" Click="OnNavigate" Content="装备与词条" />
          <Button Style="{StaticResource NavButton}" Tag="character" Click="OnNavigate" Content="角色" />
          <Button Style="{StaticResource NavButton}" Tag="detector" Click="OnNavigate" Content="字段探测器" />
          <Button Style="{StaticResource NavButton}" Tag="loadouts" Click="OnNavigate" Content="配置与快照" />
          <Button Style="{StaticResource NavButton}" Tag="logs" Click="OnNavigate" Content="活动记录" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Background="#172235" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
          <StackPanel>
            <TextBlock Text="外置模式" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
            <TextBlock Text="不安装模组；仅在你点击连接后访问游戏进程。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="28,24,28,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,20">
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="概览" FontSize="28" FontWeight="SemiBold" />
          <TextBlock x:Name="PageSubtitle" Text="连接游戏后核对已验证特征码，再逐项启用。" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
        </StackPanel>
        <Border HorizontalAlignment="Right" Background="#263247" BorderBrush="#43536C" BorderThickness="1" CornerRadius="16" Padding="12,6">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
            <TextBlock x:Name="ConnectionText" Text="未连接游戏" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid>
            <Grid x:Name="OverviewView">
              <StackPanel>
                <UniformGrid Columns="3" Margin="0,0,0,18">
                  <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                      <TextBlock Text="运行时" Foreground="{StaticResource MutedBrush}" />
                      <TextBlock x:Name="RuntimeStateText" Text="未连接" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0" />
                      <TextBlock x:Name="RuntimeDetailText" Text="尚未绑定游戏进程" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                      <TextBlock Text="物品目录" Foreground="{StaticResource MutedBrush}" />
                      <TextBlock x:Name="SignatureStateText" Text="等待扫描" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0" />
                      <TextBlock x:Name="SignatureDetailText" Text="目标：当前游戏版本的特征码" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="写入权限" Foreground="{StaticResource MutedBrush}" />
                      <TextBlock x:Name="WriteStateText" Text="已锁定" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0" />
                      <TextBlock x:Name="WriteStateDetailText" Text="先捕获目标地址，再允许单项写入" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="已验证的首批功能" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="物品数量与货币已经有旧版本的特征码。先连接游戏并扫描；只有两个特征码均唯一匹配时，才开启捕获与写入。装备品质、词条与属性请使用“字段探测器”逐项定位。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                      <Button Style="{StaticResource ActionButton}" Content="连接游戏" Click="OnConnectGame" />
                      <Button Style="{StaticResource SecondaryButton}" Content="检查已知定位" Click="OnScanKnownSignatures" Margin="10,0,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <Grid x:Name="ItemsView" Visibility="Collapsed">
              <StackPanel>
                <Border Style="{StaticResource Card}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                      <TextBlock Text="物品名称或 GUID" Foreground="{StaticResource MutedBrush}" />
                      <TextBox Margin="0,7,0,0" Height="34" Padding="9,5" Text="例如：修理粉末" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                      <TextBlock Text="分类" Foreground="{StaticResource MutedBrush}" />
                      <ComboBox Margin="0,7,0,0" Height="34" SelectedIndex="0"><ComboBoxItem Content="全部物品" /><ComboBoxItem Content="材料" /><ComboBoxItem Content="装备" /><ComboBoxItem Content="余烬" /></ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="数量" Foreground="{StaticResource MutedBrush}" />
                      <TextBox Margin="0,7,0,0" Height="34" Padding="9,5" Text="5" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Text="当前可堆叠物品数量（已验证特征码）" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="点击开始捕获后，在游戏里卖出/使用目标材料 1 个。程序将自动记住那一堆材料的数量地址；捕获完成后才可读写。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                      <CheckBox x:Name="KeepLastItemCheck" Content="最后 1 个保留" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" />
                      <Button Style="{StaticResource ActionButton}" Content="开始捕获材料" Click="OnStartItemCapture" />
                      <Button Style="{StaticResource SecondaryButton}" Content="读取捕获结果" Click="OnReadItemCapture" Margin="10,0,0,0" />
                      <Button Style="{StaticResource SecondaryButton}" Content="停止材料保护" Click="OnStopItemCapture" Margin="10,0,0,0" />
                      <TextBox x:Name="ItemQuantityBox" Width="110" Height="34" Padding="9,5" Text="20" Margin="18,0,0,0" />
                      <Button Style="{StaticResource ActionButton}" Content="写入数量" Click="OnWriteItemQuantity" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="ItemCaptureText" Text="尚未捕获任何物品。" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <Grid x:Name="EquipmentView" Visibility="Collapsed">
              <StackPanel>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="装备品质" FontSize="17" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,12,0,0">
                      <Button Style="{StaticResource SecondaryButton}" Content="Common（白）" Tag="Common" Click="OnRarityClick" Margin="0,0,8,8" />
                      <Button Style="{StaticResource SecondaryButton}" Content="Magical（蓝）" Tag="Magical" Click="OnRarityClick" Margin="0,0,8,8" />
                      <Button Style="{StaticResource SecondaryButton}" Content="Plagued（瘟疫）" Tag="Plagued" Click="OnRarityClick" Margin="0,0,8,8" />
                      <Button Style="{StaticResource SecondaryButton}" Content="Gold（仅目录武器）" Tag="Gold" Click="OnRarityClick" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock x:Name="RarityHint" Text="尚未选择品质。Gold 不进入通用自定义生成流程。" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                      <TextBlock Text="词条" FontSize="17" FontWeight="SemiBold" />
                      <TextBlock Text="瘟疫装规则：4 正面 + 1 负面。" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
                      <ComboBox Margin="0,14,0,0" Height="34"><ComboBoxItem Content="词条 1：待加载目录" /></ComboBox>
                      <Button Style="{StaticResource ActionButton}" Content="用字段探测器定位词条" Click="OnOpenDetector" Margin="0,14,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                      <TextBlock Text="词条品质与宝石" FontSize="17" FontWeight="SemiBold" />
                      <TextBlock Text="词条品质：10% - 100%；宝石须与装备类型匹配。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0" />
                      <Slider Minimum="10" Maximum="100" Value="100" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,12,0,0" />
                      <Button Style="{StaticResource ActionButton}" Content="用字段探测器定位品质" Click="OnOpenDetector" Margin="0,9,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Grid>

            <Grid x:Name="CharacterView" Visibility="Collapsed">
              <StackPanel>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="货币" FontSize="17" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,12,0,0">
                      <Button Style="{StaticResource SecondaryButton}" Content="铜币" Tag="Copper" Click="OnCurrencyClick" Margin="0,0,8,8" />
                      <Button Style="{StaticResource SecondaryButton}" Content="银币" Tag="Silver" Click="OnCurrencyClick" Margin="0,0,8,8" />
                      <Button Style="{StaticResource SecondaryButton}" Content="金币" Tag="Gold" Click="OnCurrencyClick" Margin="0,0,8,8" />
                      <Button Style="{StaticResource SecondaryButton}" Content="Gloamseed" Tag="Gloamseed" Click="OnCurrencyClick" Margin="0,0,8,8" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <Button Style="{StaticResource ActionButton}" Content="自动定位当前钱包" Click="OnStartCurrencyCapture" />
                      <Button Style="{StaticResource SecondaryButton}" Content="读取当前钱包" Click="OnReadCurrencyCapture" Margin="10,0,0,0" />
                      <TextBox x:Name="CurrencyValueBox" Width="130" Height="34" Padding="9,5" Text="1000" Margin="18,0,0,0" />
                      <Button Style="{StaticResource ActionButton}" Content="写入当前货币" Click="OnWriteCurrency" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="CurrencyCaptureText" Text="货币已有已验证定位。每次重启游戏后，只需让所选货币增减一次，程序即可自动定位本次的钱包地址。" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Text="属性与洗点" FontSize="17" FontWeight="SemiBold" />
                    <UniformGrid Columns="4" Margin="0,12,0,0">
                      <TextBlock Text="力量  10" /><TextBlock Text="敏捷  10" /><TextBlock Text="智力  10" /><TextBlock Text="信仰  10" />
                    </UniformGrid>
                    <TextBlock Text="属性地址尚未验证。请使用字段探测器，以当前属性值为初始值；升级或洗点后再筛选。" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                    <Button Style="{StaticResource ActionButton}" Content="打开属性探测器" Click="OnOpenDetector" HorizontalAlignment="Left" Margin="0,14,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <Grid x:Name="DetectorView" Visibility="Collapsed">
              <StackPanel>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="4 Bytes 数值变化探测器" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="适合属性点、装备等级、词条数或其它能明确看到整数变化的字段。它不修改游戏：先按初始值扫描，再让游戏内目标变化一次，最后按新值筛选。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Grid Margin="0,16,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="变化前" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="DetectorBeforeBox" Height="34" Padding="9,5" Text="10" Margin="0,7,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="变化后" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="DetectorAfterBox" Height="34" Padding="9,5" Text="11" Margin="0,7,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="18,0,0,0">
                        <Button Style="{StaticResource ActionButton}" Content="1. 初始扫描" Click="OnStartDetector" />
                        <Button Style="{StaticResource SecondaryButton}" Content="2. 按新值筛选" Click="OnFilterDetector" Margin="10,0,0,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="复制结果" Click="OnCopyDetectorReport" Margin="10,0,0,0" />
                      </StackPanel>
                    </Grid>
                    <TextBlock x:Name="DetectorStatusText" Text="先连接游戏，再填入游戏里当前可见的整数。" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="候选地址（最多展示 100 个）" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ListBox x:Name="DetectorResults" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MinHeight="260" />
                  </DockPanel>
                </Border>
              </StackPanel>
            </Grid>

            <Grid x:Name="LoadoutsView" Visibility="Collapsed">
              <StackPanel>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="快照生成" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="根据 Build/Planner 数据生成等价新装备；不是复制现有物品 GUID。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0" />
                    <TextBox Height="34" Padding="9,5" Margin="0,14,0,0" Text="https://www.norestforthewicked.gg/planner/..." />
                    <TextBlock Text="外置版暂不写入快照；先完成物品实例结构探测后再实现。" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Text="配置槽位" FontSize="17" FontWeight="SemiBold" />
                    <UniformGrid Columns="5" Margin="0,12,0,0">
                      <Button Style="{StaticResource SecondaryButton}" Content="配置 1&#x0a;空" Tag="配置 1" Click="OnPreviewAction" Margin="0,0,8,0" />
                      <Button Style="{StaticResource SecondaryButton}" Content="配置 2&#x0a;空" Tag="配置 2" Click="OnPreviewAction" Margin="0,0,8,0" />
                      <Button Style="{StaticResource SecondaryButton}" Content="配置 3&#x0a;空" Tag="配置 3" Click="OnPreviewAction" Margin="0,0,8,0" />
                      <Button Style="{StaticResource SecondaryButton}" Content="配置 4&#x0a;空" Tag="配置 4" Click="OnPreviewAction" Margin="0,0,8,0" />
                      <Button Style="{StaticResource SecondaryButton}" Content="配置 5&#x0a;空" Tag="配置 5" Click="OnPreviewAction" />
                    </UniformGrid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <Grid x:Name="LogsView" Visibility="Collapsed">
              <Border Style="{StaticResource Card}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="本次界面操作" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                  <ListBox x:Name="ActivityLog" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" />
                </DockPanel>
              </Border>
            </Grid>
          </Grid>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="2" Margin="0,18,0,0" Background="#121A28" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock x:Name="ActionStatusText" Text="界面已就绪：尚未连接游戏。" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
