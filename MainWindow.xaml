<Window x:Class="NRftWManagerUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NRftWManagerUI"
        Title="RIFT//CTRL" Icon="Assets/riftctrl.ico" Height="940" Width="1600" MinHeight="760" MinWidth="1300"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#020610">
  <Border Background="{StaticResource SciFiGridBrush}" BorderBrush="#174379" BorderThickness="1" CornerRadius="8">
  <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="78" />
        <RowDefinition Height="180" />
        <RowDefinition Height="*" />
        <RowDefinition Height="36" />
      </Grid.RowDefinitions>
      <Rectangle Grid.RowSpan="4" Grid.ColumnSpan="3" Fill="{StaticResource TechGridBrush}" IsHitTestVisible="False" />

      <Border Grid.RowSpan="4" Background="#EB040914" BorderBrush="#153A67" BorderThickness="0,0,1,0" CornerRadius="8,0,0,8">
        <Grid Margin="14,0">
          <Grid.RowDefinitions><RowDefinition Height="104" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
            <StackPanel Orientation="Horizontal">
              <Image Source="Assets/riftctrl-icon.png" Width="42" Height="42" Stretch="UniformToFill" Margin="0,0,10,0" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock FontFamily="Bahnschrift, Segoe UI" FontSize="19" FontWeight="SemiBold"><Run Text="RIFT" /><Run Text="//" Foreground="#9B45FF" /><Run Text="CTRL" /></TextBlock>
                <TextBlock Text="YOUR GAMES. YOUR RULES." FontFamily="Consolas" FontSize="8" Foreground="#8BA1C2" Margin="0,3,0,0" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <TextBlock Text="CONTROL CENTER" Foreground="#5E789B" FontSize="9" FontWeight="SemiBold" Margin="11,0,0,8" />
            <RadioButton x:Name="LibraryNavButton" Style="{StaticResource SidebarNavigationButton}" Tag="library" Checked="OnGlobalNavigation" IsChecked="True">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource SidebarGlyph}" /><StackPanel><TextBlock Text="游戏库" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="本机已安装游戏" Style="{StaticResource SidebarCaption}" /></StackPanel></StackPanel>
            </RadioButton>
            <RadioButton x:Name="ModifierNavButton" Style="{StaticResource SidebarNavigationButton}" Tag="modifier" Checked="OnGlobalNavigation">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource SidebarGlyph}" /><StackPanel><TextBlock Text="修改器中心" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="当前游戏功能" Style="{StaticResource SidebarCaption}" /></StackPanel></StackPanel>
            </RadioButton>
            <Border Style="{StaticResource SidebarMutedEntry}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" Style="{StaticResource SidebarGlyph}" /><StackPanel><TextBlock Text="配置方案" FontSize="14" /><TextBlock Text="我的配置方案" Style="{StaticResource SidebarCaption}" /></StackPanel></StackPanel></Border>
            <Border Style="{StaticResource SidebarMutedEntry}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE765;" Style="{StaticResource SidebarGlyph}" /><StackPanel><TextBlock Text="热键管理" FontSize="14" /><TextBlock Text="全局热键设置" Style="{StaticResource SidebarCaption}" /></StackPanel></StackPanel></Border>
            <Border Style="{StaticResource SidebarMutedEntry}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{StaticResource SidebarGlyph}" /><StackPanel><TextBlock Text="扩展工具" FontSize="14" /><TextBlock Text="脚本与工具" Style="{StaticResource SidebarCaption}" /></StackPanel></StackPanel></Border>
            <Border Style="{StaticResource SidebarMutedEntry}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource SidebarGlyph}" /><StackPanel><TextBlock Text="设置" FontSize="14" /><TextBlock Text="界面与其他" Style="{StaticResource SidebarCaption}" /></StackPanel></StackPanel></Border>
          </StackPanel>
          <Grid Grid.Row="2" Width="170" Height="170" VerticalAlignment="Bottom" Margin="0,0,0,18" Opacity="0.8" IsHitTestVisible="False">
            <Ellipse Stroke="#174E91" StrokeThickness="1" />
            <Ellipse Width="124" Height="124" Stroke="#286ED1" StrokeThickness="1" StrokeDashArray="5,5" />
            <Ellipse Width="78" Height="78" Stroke="#7B39FF" StrokeThickness="2" />
            <Ellipse Width="28" Height="28" Fill="#4123A6" Stroke="#35D9FF" StrokeThickness="2"><Ellipse.Effect><DropShadowEffect Color="#3F8CFF" BlurRadius="24" ShadowDepth="0" Opacity="0.95" /></Ellipse.Effect></Ellipse>
            <Line X1="85" Y1="0" X2="85" Y2="170" Stroke="#1A4F88" StrokeThickness="1" />
            <Line X1="0" Y1="85" X2="170" Y2="85" Stroke="#1A4F88" StrokeThickness="1" />
            <Path Data="M85,18 L97,52 L85,45 L73,52 Z" Fill="#3BD8FF" Opacity="0.8" />
          </Grid>
          <StackPanel Grid.Row="3" Margin="8,0,8,18">
            <Border Background="#071425" BorderBrush="#1B477A" BorderThickness="1" CornerRadius="5" Padding="13,11">
              <StackPanel><TextBlock Text="RIFT CORE" Foreground="#46D6FF" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="本地内存模式 · NO MOD" Foreground="#7187A5" FontSize="9" Margin="0,4,0,0" /></StackPanel>
            </Border>
            <TextBlock Text="BUILD 1.45  ·  SECURE CORE" Foreground="#405A7A" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Margin="0,11,0,0" />
          </StackPanel>
          <Border Grid.Row="4" Background="#071425" BorderBrush="#1B477A" BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="8,0,8,20"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#47E49A" VerticalAlignment="Center" Margin="0,0,8,0" /><StackPanel><TextBlock Text="RIFT//CTRL PRO" FontSize="10" Foreground="#9DE7FF" /><TextBlock Text="本地授权" FontSize="9" Foreground="#48DFA0" Margin="0,2,0,0" /></StackPanel></StackPanel></Border>
        </Grid>
      </Border>

      <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" Padding="18,0,10,0" Background="#E9040914" BorderBrush="#153A67" BorderThickness="0,0,0,1" CornerRadius="0,8,0,0" MouseLeftButtonDown="OnTitleBarMouseDown">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBox x:Name="LibrarySearchBox" Width="315" Height="40" Padding="38,6,12,6" TextChanged="OnLibrarySearchChanged" ToolTip="搜索已安装游戏">
              <TextBox.Background><SolidColorBrush Color="#060D19" /></TextBox.Background>
            </TextBox>
            <Path Data="M0,0 A6,6 0 1 1 0.1,0 M4.5,4.5 L9,9" Stroke="#7C98BF" StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" Margin="-296,0,282,0" IsHitTestVisible="False" />
            <ComboBox x:Name="GameSelector" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" Padding="0" SelectionChanged="OnGameSelectionChanged" MaxDropDownHeight="420">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <Grid MinWidth="355"><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="5" Background="#0B1627" BorderBrush="#214D7D" BorderThickness="1" ClipToBounds="True"><Image Source="{Binding IconPath}" Stretch="UniformToFill" /></Border><StackPanel Grid.Column="1" Margin="9,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#F4F7FF" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding InstallPath}" FontSize="8" Foreground="#637B9D" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding Platform}" FontSize="9" Foreground="#8FCFFF" VerticalAlignment="Center" /></Grid>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="RefreshGameLibraryButton" Style="{StaticResource SecondaryButton}" Content="↻  重新扫描" Click="OnRefreshGameLibrary" Height="40" Padding="16,7" Margin="9,0,0,0" ToolTip="重新扫描 Steam 和 Epic 游戏库" />
            <TextBlock x:Name="GameLibrarySummaryText" Text="正在扫描 Steam 与 Epic…" Foreground="#637B9D" FontSize="10" Margin="15,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource HeaderIconButton}" Content="&#xE7F4;" ToolTip="通知" />
            <Button Style="{StaticResource HeaderIconButton}" Content="&#xE713;" ToolTip="设置" Margin="8,0,14,0" />
            <Border Background="#071425" BorderBrush="#1A4779" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,13,0"><StackPanel Orientation="Horizontal"><Image Source="Assets/riftctrl-icon.png" Width="24" Height="24" Margin="0,0,8,0" /><TextBlock Text="RIFT-USER" Foreground="#D6E6FF" FontSize="10" VerticalAlignment="Center" /><Border Background="#6F2FFF" CornerRadius="3" Padding="5,2" Margin="8,0,0,0"><TextBlock Text="PRO" FontSize="9" FontWeight="Bold" /></Border></StackPanel></Border>
            <Button Style="{StaticResource WindowControlButton}" Click="OnMinimizeWindow" ToolTip="最小化">
              <Path Data="M 0,0 L 12,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" />
            </Button>
            <Button Style="{StaticResource CloseWindowButton}" Click="OnCloseWindow" ToolTip="关闭">
              <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="GameHeroPanel" Grid.Column="1" Grid.Row="1" Background="#B9050B17" BorderBrush="#153A67" BorderThickness="0,0,0,1" Padding="24,14" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Image Grid.ColumnSpan="2" Source="Assets/riftctrl-hero.png" Stretch="UniformToFill" Opacity="0.92" />
          <Rectangle Grid.ColumnSpan="2" Fill="{StaticResource HeroShadeBrush}" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="72" Height="72" CornerRadius="8" Background="#071425" BorderBrush="#27599A" BorderThickness="1" ClipToBounds="True" Margin="0,0,16,0"><Image Source="{Binding ElementName=GameSelector, Path=SelectedItem.IconPath}" Stretch="UniformToFill" /></Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding ElementName=GameSelector, Path=SelectedItem.Name, TargetNullValue=选择一个游戏}" FontSize="24" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Border Background="#082219" BorderBrush="#0D754D" BorderThickness="1" CornerRadius="4" Padding="9,3"><TextBlock Text="已适配" Foreground="#41E7A1" FontSize="10" /></Border><Border Background="#160D2C" BorderBrush="#7137B5" BorderThickness="1" CornerRadius="4" Padding="9,3" Margin="7,0,0,0"><TextBlock Text="RIFT//CTRL" Foreground="#C490FF" FontSize="10" /></Border><TextBlock Text="{Binding ElementName=GameSelector, Path=SelectedItem.Platform}" Foreground="#7991B0" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" /></StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
              <TextBlock Text="连接状态" Foreground="#777A86" FontSize="9" HorizontalAlignment="Right" />
              <StackPanel Orientation="Horizontal" Margin="0,5,0,0" HorizontalAlignment="Right">
                <Ellipse x:Name="ConnectionIndicator" Width="7" Height="7" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock x:Name="ConnectionText" Text="未连接" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="SemiBold" />
              </StackPanel>
            </StackPanel>
            <Button x:Name="ConnectButton" Style="{StaticResource ActionButton}" Click="OnConnectGame" MinWidth="142" Height="44" Padding="18,8" IsEnabled="False">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ConnectSpinner" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeDashArray="2,2" Visibility="Collapsed" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                  <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360" Duration="0:0:0.8" /></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers>
                </Ellipse>
                <Path Data="M0,0 L0,12 L10,6 Z" Fill="White" Width="10" Height="12" Stretch="Fill" Margin="0,0,9,0" VerticalAlignment="Center" />
                <TextBlock x:Name="ConnectButtonLabel" Text="连接游戏" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid x:Name="ModifierBodyPanel" Grid.Column="1" Grid.Row="2" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}" Visibility="Collapsed">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="SYSTEM TELEMETRY" Style="{StaticResource MicroLabel}" />
              <TextBlock Text="实时状态" Style="{StaticResource SectionTitle}" FontSize="19" Margin="0,5,0,0" />
              <Rectangle Height="1" Fill="#36566A" Margin="0,13,0,0" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource TelemetryCard}" Margin="0,13,0,0">
              <StackPanel>
                <TextBlock Text="01 / RUNTIME" Style="{StaticResource MicroLabel}" />
                <TextBlock x:Name="RuntimeStateText" Text="未连接" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Margin="0,7,0,0" />
                <TextBlock x:Name="RuntimeDetailText" Text="等待游戏进程" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Row="2">
              <Border Style="{StaticResource TelemetryCard}" Margin="0,9,0,0">
                <StackPanel>
                  <TextBlock Text="02 / SIGNATURE" Style="{StaticResource MicroLabel}" />
                  <TextBlock x:Name="SignatureStateText" Text="等待扫描" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Margin="0,7,0,0" />
                  <TextBlock x:Name="SignatureDetailText" Text="当前构建特征码" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource TelemetryCard}" Margin="0,9,0,0">
                <StackPanel>
                  <TextBlock Text="03 / WRITE GATE" Style="{StaticResource MicroLabel}" />
                  <TextBlock x:Name="WriteStateText" Text="已锁定" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Margin="0,7,0,0" />
                  <TextBlock x:Name="WriteStateDetailText" Text="等待目标验证" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Grid.Row="4">
              <Rectangle Height="1" Fill="#29475A" Margin="0,0,0,12" />
              <TextBlock Text="OPERATOR NOTE" Style="{StaticResource MicroLabel}" Foreground="{StaticResource WarningBrush}" />
              <TextBlock Text="先在游戏中点击目标物品，再执行单项写入。界面只显示当前已验证模块。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0" />
              <TextBlock Text="BUILD 1.45 / NODE 01" FontFamily="Consolas" FontSize="9" Foreground="#49677A" Margin="0,15,0,0" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid x:Name="OperationSurface" Grid.Column="1" Visibility="Collapsed" Margin="24,14,24,14">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Opacity" Value="1" />
              <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.34" /></Trigger></Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.RowDefinitions><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid x:Name="OverviewView" Visibility="Collapsed" />

            <TabControl x:Name="MainFeatureTabs" SelectedIndex="0" SelectionChanged="OnMainFeatureTabChanged">
              <TabItem x:Name="GeneralTab" Header="常规功能" IsEnabled="False">
                <StackPanel Margin="0,2,0,0" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Margin="2,0,0,14">
                    <TextBlock Text="常规功能" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="角色状态与游戏货币" Foreground="#6D86A7" FontSize="10" VerticalAlignment="Bottom" Margin="12,0,0,3" />
                  </StackPanel>
                  <Border Style="{StaticResource Card}" Padding="22,18">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="货币" Style="{StaticResource SectionTitle}" FontSize="18" />
                        <TextBlock x:Name="CurrencyCaptureText" Text="选择币种并输入要增加的数量" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CurrencyCopperButton" Style="{StaticResource SecondaryButton}" Content="铜币" Tag="Copper" Click="OnCurrencyClick" Padding="14,8" Margin="0,0,6,0" />
                        <Button x:Name="CurrencySilverButton" Style="{StaticResource SecondaryButton}" Content="银币" Tag="Silver" Click="OnCurrencyClick" Padding="14,8" Margin="0,0,6,0" />
                        <Button x:Name="CurrencyGoldButton" Style="{StaticResource SecondaryButton}" Content="金币" Tag="Gold" Click="OnCurrencyClick" Padding="14,8" Background="#8B6CFF" BorderBrush="#8B6CFF" Foreground="#FFFFFF" Margin="0,0,14,0" />
                        <TextBox x:Name="CurrencyValueBox" Width="140" Height="40" Padding="12,6" Text="1000" FontSize="14" />
                        <Button Style="{StaticResource ActionButton}" Content="增加货币" Click="OnWriteCurrency" MinWidth="104" Padding="16,9" Margin="9,0,0,0" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,12,0,0">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <StackPanel>
                        <TextBlock Text="玩家状态" Style="{StaticResource SectionTitle}" FontSize="18" />
                        <TextBlock Text="开启后在游戏运行期间持续生效" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
                      </StackPanel>
                      <UniformGrid Grid.Row="1" Columns="3" Margin="0,16,0,0">
                        <Border Background="{StaticResource ControlCellGradient}" BorderBrush="#2D2F38" BorderThickness="1" CornerRadius="9" Padding="16,14" Margin="0,0,7,0">
                          <Grid><StackPanel><TextBlock Text="无限生命" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="生命值保持满值" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel><CheckBox Tag="health" Click="OnToggleInfiniteStat" HorizontalAlignment="Right" /></Grid>
                        </Border>
                        <Border Background="{StaticResource ControlCellGradient}" BorderBrush="#2D2F38" BorderThickness="1" CornerRadius="9" Padding="16,14" Margin="7,0">
                          <Grid><StackPanel><TextBlock Text="无限体力" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="动作不消耗体力" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel><CheckBox Tag="stamina" Click="OnToggleInfiniteStat" HorizontalAlignment="Right" /></Grid>
                        </Border>
                        <Border Background="{StaticResource ControlCellGradient}" BorderBrush="#2D2F38" BorderThickness="1" CornerRadius="9" Padding="16,14" Margin="7,0,0,0">
                          <Grid><StackPanel><TextBlock Text="无限专注" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="技能不消耗专注" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel><CheckBox Tag="focus" Click="OnToggleInfiniteStat" HorizontalAlignment="Right" /></Grid>
                        </Border>
                      </UniformGrid>
                    </Grid>
                  </Border>
                </StackPanel>
              </TabItem>
              <TabItem x:Name="ItemEditTab" Header="物品修改" IsEnabled="False">
                <Grid Margin="0,2,0,0" VerticalAlignment="Top">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Border Style="{StaticResource Card}" Padding="22,17" Margin="0,0,0,12">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <Border Width="44" Height="44" Background="#1C1D24" BorderBrush="#30323B" BorderThickness="1" CornerRadius="9" VerticalAlignment="Center">
                        <Path Data="M12,8 H36 V40 H12 Z M18,15 H30 M18,22 H30 M18,29 H26" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Stretch="Uniform" Margin="12" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="当前物品" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <TextBlock x:Name="SelectedItemText" Text="尚未选择物品" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                      <Expander Grid.Column="2" Header="高级" IsExpanded="False" Foreground="#737D8F" VerticalAlignment="Center">
                        <StackPanel Width="300" Margin="0,8,0,0">
                          <ListBox x:Name="SelectedItemHistoryList" Height="72" FontFamily="Consolas" FontSize="11" />
                          <Button Style="{StaticResource SecondaryButton}" Content="复制诊断" Click="OnCopyItemNameDiagnostic" HorizontalAlignment="Right" Margin="0,7,0,0" />
                          <TextBox x:Name="ItemNameDiagnosticBox" Text="尚无物品名称诊断。" IsReadOnly="True" Visibility="Collapsed" />
                        </StackPanel>
                      </Expander>
                    </Grid>
                  </Border>

                  <Border Grid.Row="1" x:Name="ItemsView" Style="{StaticResource Card}" Padding="22,20">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,22,0">
                        <TextBlock Text="物品数量" Style="{StaticResource SectionTitle}" FontSize="17" />
                        <TextBlock x:Name="ItemCaptureText" Text="等待数量变化" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <Grid Margin="0,14,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <TextBox x:Name="ItemQuantityBox" MinWidth="110" Height="40" Padding="12,6" Text="20" FontSize="15" />
                          <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="写入数量" Click="OnWriteItemQuantity" Padding="15,9" Margin="9,0,0,0" />
                        </Grid>
                        <CheckBox x:Name="KeepLastItemCheck" Content="保留最后 1 个" IsChecked="True" Click="OnKeepLastItemChanged" Margin="0,13,0,0" />
                      </StackPanel>

                      <Border Grid.Column="1" Background="#2A2C34" />
                      <StackPanel Grid.Column="2" Margin="22,0">
                        <TextBlock Text="品质" Style="{StaticResource SectionTitle}" FontSize="17" />
                        <TextBlock Text="直接应用到当前物品" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
                        <UniformGrid Columns="3" Margin="0,20,0,0">
                          <Button Style="{StaticResource RarityButton}" BorderBrush="#AFC3D1" Foreground="#EAF4F8" Content="白色" Tag="Common" Click="OnQueueRarity" Padding="10,8" Margin="0,0,5,0" />
                          <Button Style="{StaticResource RarityButton}" BorderBrush="#5AB8FF" Foreground="#8CCBFF" Content="蓝色" Tag="Magical" Click="OnQueueRarity" Padding="10,8" Margin="5,0" />
                          <Button Style="{StaticResource RarityButton}" BorderBrush="{StaticResource PurpleBrush}" Foreground="#F1ACFF" Content="紫色" Tag="Plagued" Click="OnQueueRarity" Padding="10,8" Margin="5,0,0,0" />
                        </UniformGrid>
                      </StackPanel>

                      <Border Grid.Column="3" Background="#2A2C34" />
                      <StackPanel Grid.Column="4" Width="175" Margin="22,0,0,0">
                        <TextBlock Text="复制" Style="{StaticResource SectionTitle}" FontSize="17" />
                        <TextBlock Text="以当前物品为模板" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
                        <Button Style="{StaticResource ActionButton}" Content="复制当前物品" Click="OnCreateFromSelectedTemplate" HorizontalAlignment="Stretch" Margin="0,20,0,0" Padding="14,9" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </Grid>
              </TabItem>

              <TabItem x:Name="CapturedCatalogTab" Header="物品库" IsEnabled="False">
                <Grid x:Name="EquipmentView" Margin="0,2,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>

                  <Border Style="{StaticResource Card}" Margin="0,0,7,0" Padding="24,22">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="物品库" Style="{StaticResource SectionTitle}" />
                          <TextBlock Text="从已保存模板中选择物品" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1B202C" CornerRadius="9" Padding="11,7" VerticalAlignment="Center">
                          <TextBlock x:Name="CapturedItemCatalogSummary" Text="等待物品数据" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </Border>
                      </Grid>
                      <Grid Grid.Row="1" Margin="0,18,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Path Data="M2,2 L12,12 M7,2 A5,5 0 1 0 7,12 A5,5 0 1 0 7,2" Stroke="#78849A" StrokeThickness="1.6" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1" x:Name="CapturedItemSearchBox" Height="42" Padding="12,7" TextChanged="OnFilterCapturedItems" ToolTip="输入中文名、内部路径或 GUID" />
                      </Grid>
                      <ListBox Grid.Row="2" x:Name="CapturedItemCatalogList" SelectionChanged="OnCapturedItemSelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Resources>
                          <DataTemplate DataType="{x:Type local:MainWindow+CapturedItemCategoryHeader}">
                            <Border Background="#111722" BorderBrush="#273247" BorderThickness="0,0,0,1" Padding="0,10,0,7" Margin="0,8,0,4">
                              <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Category}" FontSize="12" FontWeight="SemiBold" Foreground="#BDAEFF" />
                                <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0} 个}" FontSize="10" Foreground="#687284" HorizontalAlignment="Right" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                          <DataTemplate DataType="{x:Type local:MainWindow+CapturedItemTemplate}">
                            <Grid Margin="2,4">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                              <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="#EFF7FF" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Metadata}" FontSize="10" Foreground="#687284" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                              </StackPanel>
                              <Border Grid.Column="1" Height="22" Padding="8,0" CornerRadius="6" Background="#1D2130" BorderBrush="#30384D" BorderThickness="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#AAB6CA" VerticalAlignment="Center" />
                              </Border>
                            </Grid>
                          </DataTemplate>
                        </ListBox.Resources>
                      </ListBox>
                    </Grid>
                  </Border>

                  <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0" Padding="24,22">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <StackPanel>
                        <TextBlock Text="生成物品" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="以左侧选中模板创建新物品" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Row="1" Margin="0,28,0,0">
                        <TextBlock Text="物品名称" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        <TextBox x:Name="CapturedItemNameBox" Height="42" Padding="12,7" Margin="0,7,0,0" ToolTip="选中物品的中文名称" />
                        <TextBlock x:Name="CatalogCreateCountLabel" Text="生成数量" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,18,0,0" />
                        <TextBox x:Name="CatalogCreateCountBox" Height="42" Padding="12,7" Text="1" Margin="0,7,0,0" ToolTip="生成数量（1–99）" />
                        <Button Style="{StaticResource ActionButton}" Content="生成选中物品" Click="OnCreateFromCapturedTemplate" HorizontalAlignment="Stretch" Margin="0,16,0,0" />
                      </StackPanel>
                      <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="名称不正确时可直接修改" Foreground="#717B8C" FontSize="10" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="保存名称" Click="OnSaveCapturedItemName" Padding="12,7" />
                      </Grid>
                    </Grid>
                  </Border>

                  <Grid Visibility="Collapsed">
                    <TextBox x:Name="CreateItemCountBox" Text="1" />
                    <ComboBox x:Name="CreateItemRarityBox" SelectedIndex="0"><ComboBoxItem Content="Common（白）" /><ComboBoxItem Content="Magical（蓝）" /><ComboBoxItem Content="Plagued（紫）" /><ComboBoxItem Content="Gold（金）" /></ComboBox>
                    <TextBox x:Name="ItemLevelBox" Text="30" />
                  </Grid>
                </Grid>
              </TabItem>

              <TabItem x:Name="IconCatalogTab">
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="图标物品库" />
                    <Ellipse x:Name="IconCatalogTabSpinner" Width="11" Height="11" Stroke="#BDAEFF" StrokeThickness="1.7" StrokeDashArray="2,2" Visibility="Collapsed" Margin="7,0,0,0" RenderTransformOrigin="0.5,0.5">
                      <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                      <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.8" /></Storyboard></BeginStoryboard></EventTrigger>
                      </Ellipse.Triggers>
                    </Ellipse>
                  </StackPanel>
                </TabItem.Header>
                <Grid x:Name="IconCatalogContentRoot" Margin="0,2,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="0.78*" /></Grid.ColumnDefinitions>

                  <Border Style="{StaticResource Card}" Margin="0,0,7,0" Padding="18,16">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="物品" Style="{StaticResource SectionTitle}" />
                          <TextBlock Text="与当前游戏版本同步" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1B202C" CornerRadius="8" Padding="9,5" VerticalAlignment="Center">
                          <TextBlock x:Name="IconCatalogSummaryText" Text="等待扫描" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        </Border>
                        <Button Grid.Column="2" x:Name="ScanLocalItemsButton" Style="{StaticResource SecondaryButton}" Click="OnScanLocalItems" Padding="10,5" Margin="6,0,0,0">
                          <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ScanLocalItemsSpinner" Width="11" Height="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeDashArray="2,2" Visibility="Collapsed" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                              <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                              <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.8" /></Storyboard></BeginStoryboard></EventTrigger>
                              </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock x:Name="ScanLocalItemsButtonText" Text="更新物品" />
                          </StackPanel>
                        </Button>
                      </Grid>

                      <Grid Grid.Row="1" Margin="0,12,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Path Data="M2,2 L12,12 M7,2 A5,5 0 1 0 7,12 A5,5 0 1 0 7,2" Stroke="#78849A" StrokeThickness="1.5" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" x:Name="IconCatalogSearchBox" Height="34" Padding="10,5" FontSize="11" TextChanged="OnFilterIconCatalogItems" ToolTip="支持中文、拼音、英文与资源键" />
                        <Button Grid.Column="2" x:Name="ClearIconCatalogSearchButton" Style="{StaticResource SecondaryButton}" Content="清空" Click="OnClearIconCatalogSearch" Padding="10,5" Margin="6,0,0,0" Visibility="Collapsed" />
                      </Grid>

                      <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="138" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                        <ListBox x:Name="IconCatalogCategoryList" SelectionChanged="OnIconCatalogCategoryChanged" Background="#0B0D13" BorderBrush="#242B3B" BorderThickness="1" Padding="6" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                          <ListBox.ItemTemplate>
                            <DataTemplate>
                              <Border Background="#10141D" BorderBrush="#252E42" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,7">
                                <Grid>
                                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                  <TextBlock Text="{Binding Icon}" FontSize="12" Foreground="#C9BCFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#EFF7FF" VerticalAlignment="Center" />
                                  <Border Grid.Column="2" Background="#20283A" CornerRadius="7" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CountText}" FontSize="9" Foreground="#AEB8CC" />
                                  </Border>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox Grid.Column="1" x:Name="IconCatalogList" Margin="10,0,0,0" SelectionChanged="OnIconCatalogSelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                          <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ListBox.ItemsPanel>
                          <ListBox.ItemTemplate>
                            <DataTemplate>
                              <Border Width="88" Height="102" Background="#10141D" BorderBrush="#263046" BorderThickness="1" CornerRadius="8" Padding="7" Margin="4">
                                <Grid>
                                  <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                  <Border Width="42" Height="42" CornerRadius="8" Background="#171C28" BorderBrush="#303A52" BorderThickness="1" HorizontalAlignment="Center">
                                    <Grid>
                                      <TextBlock Text="{Binding CategoryIcon}" FontSize="18" Foreground="#BDAEFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                          <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                              <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </TextBlock.Style>
                                      </TextBlock>
                                      <Image Source="{Binding IconSource}" Stretch="Uniform" Margin="2" />
                                    </Grid>
                                  </Border>
                                  <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#20283A" CornerRadius="7" Padding="5,2">
                                    <TextBlock Text="{Binding AvailabilityText}" FontSize="8" Foreground="#AEB8CC" />
                                  </Border>
                                  <TextBlock Grid.Row="1" FontSize="9.5" FontWeight="SemiBold" Foreground="#EFF7FF" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" MaxHeight="36"><Run Text="{Binding MatchPrefix}"/><Run Text="{Binding MatchText}" Foreground="#FFD36A"/><Run Text="{Binding MatchSuffix}"/></TextBlock>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Column="1" x:Name="IconCatalogRenderOverlay" Margin="10,0,0,0" Background="#B00B0D13" Visibility="Collapsed" Panel.ZIndex="10">
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="24" Height="24" Stroke="#9276FF" StrokeThickness="2.5" StrokeDashArray="2,2" RenderTransformOrigin="0.5,0.5">
                              <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                              <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.8" /></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="正在加载物品卡片…" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,9,0,0" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="1" x:Name="IconCatalogEmptyState" Margin="10,0,0,0" Background="#0B0D13" BorderBrush="#242B3B" BorderThickness="1" Visibility="Collapsed" Panel.ZIndex="11">
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260">
                            <TextBlock Text="没有找到物品" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="IconCatalogEmptyHint" Text="换个名称或清除当前分类后再试" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,12" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Style="{StaticResource SecondaryButton}" Content="清空搜索" Click="OnClearIconCatalogSearch" Padding="12,6" /><Button Style="{StaticResource SecondaryButton}" Content="查看全部" Click="OnShowAllIconCatalogItems" Padding="12,6" Margin="7,0,0,0" /></StackPanel>
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Grid>
                  </Border>

                  <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0" Padding="18,16">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                      <StackPanel>
                        <Border Width="72" Height="72" CornerRadius="12" Background="#171C28" BorderBrush="#333B52" BorderThickness="1" HorizontalAlignment="Left" ClipToBounds="True">
                          <Grid>
                            <TextBlock Text="{Binding ElementName=IconCatalogList, Path=SelectedItem.CategoryIcon}" FontSize="28" Foreground="#BDAEFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Visibility" Value="Visible" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=IconCatalogList, Path=SelectedItem.HasIcon}" Value="True">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <Image Source="{Binding ElementName=IconCatalogList, Path=SelectedItem.IconSource}" Stretch="Uniform" Margin="3" />
                          </Grid>
                        </Border>
                        <TextBlock Text="{Binding ElementName=IconCatalogList, Path=SelectedItem.DisplayName, TargetNullValue=选择一个物品}" Style="{StaticResource SectionTitle}" FontSize="20" Margin="0,14,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ElementName=IconCatalogList, Path=SelectedItem.Category}" Foreground="#BDAEFF" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" />
                      </StackPanel>

                      <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,14,0,0">
                        <Border x:Name="EquipmentCreatePanel" Background="#10141D" CornerRadius="8" Padding="11,8"><TextBlock Text="固定生成 1 件" Foreground="{StaticResource MutedBrush}" FontSize="10"/></Border>
                        <Border x:Name="StackCreatePanel" Background="#10141D" CornerRadius="8" Padding="11,8" Visibility="Collapsed"><StackPanel><TextBlock x:Name="IconCatalogCreateCountLabel" Text="数量" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBox x:Name="IconCatalogCreateCountBox" Height="36" Padding="10,5" Text="1" Margin="0,5,0,0" ToolTip="一次创建，并由游戏合并已有堆栈"/><TextBlock Text="自动叠加到已有物品；没有时新占一格" Foreground="#717B8C" FontSize="9.5" Margin="0,4,0,0"/></StackPanel></Border>
                        <Button x:Name="IconCatalogCreateButton" Style="{StaticResource ActionButton}" Click="OnCreateFromIconCatalog" HorizontalAlignment="Stretch" Margin="0,10,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse x:Name="IconCatalogCreateSpinner" Width="12" Height="12" Stroke="White" StrokeThickness="2" StrokeDashArray="2,2" Visibility="Collapsed" Margin="0,0,7,0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform><Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.8"/></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse><TextBlock x:Name="IconCatalogCreateButtonText" Text="生成物品" Foreground="White"/></StackPanel></Button>
                        <Border x:Name="IconCatalogCreateResult" Background="#10141D" CornerRadius="7" Padding="10,7" Margin="0,8,0,0" Visibility="Collapsed"><TextBlock x:Name="IconCatalogCreateResultText" FontSize="10" TextWrapping="Wrap"/></Border>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border x:Name="IconCatalogLoadingOverlay" Grid.Column="0" Margin="0,0,7,0" Background="#E6121318" CornerRadius="10" Visibility="Collapsed" Panel.ZIndex="20">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Ellipse Width="30" Height="30" Stroke="#9276FF" StrokeThickness="3" StrokeDashArray="2,2" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                          <EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.8" /></Storyboard></BeginStoryboard></EventTrigger>
                        </Ellipse.Triggers>
                      </Ellipse>
                      <TextBlock Text="正在读取游戏物品资源…" Foreground="#DDE7F7" FontSize="12" Margin="0,12,0,0" />
                      <TextBlock Text="其他功能仍可正常使用" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>
              </TabItem>

            </TabControl>

            <Grid x:Name="CharacterView" Visibility="Collapsed">
              <StackPanel>
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,12">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="OPERATOR LINK / 04" Style="{StaticResource MicroLabel}" />
                      <TextBlock Text="角色与背包通道" Style="{StaticResource SectionTitle}" Margin="0,4,0,0" />
                      <TextBlock Text="角色参数仅做旁路捕获；危险的主动背包 API 测试已停用。" Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,3,0,0" />
                      <TextBlock Text="钱包捕获与写入已移到主页面。" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                      <Button Style="{StaticResource SecondaryButton}" Content="捕获角色参数" Click="OnStartCurrencyCapture" />
                      <Button x:Name="InventoryProbeButton" Style="{StaticResource SecondaryButton}" Content="开启背包旁路捕获" Click="OnProbeInventoryComponent" IsEnabled="False" Margin="8,0,0,0" />
                      <Button Style="{StaticResource SecondaryButton}" Content="复制诊断" Click="OnCopyPlayerDiagnostic" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBox x:Name="PlayerDiagnosticBox" Grid.Row="1" Grid.ColumnSpan="2" Text="尚无角色诊断数据。" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="68" Padding="8,6" Margin="0,10,0,0" />
                  </Grid>
                </Border>
                <Grid Margin="0,0,0,12" IsEnabled="False">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,6,0">
                    <StackPanel>
                      <TextBlock Text="生命与战斗" FontSize="17" FontWeight="SemiBold" />
                      <WrapPanel Margin="0,10,0,0">
                        <CheckBox Content="无限生命" Tag="health" Click="OnTogglePlayerFlag" Margin="0,0,16,0" />
                        <CheckBox Content="无限耐力" Tag="stamina" Click="OnTogglePlayerFlag" Margin="0,0,16,0" />
                        <CheckBox Content="无限专注" Tag="focus" Click="OnTogglePlayerFlag" Margin="0,0,16,0" />
                        <CheckBox Content="一击必杀" Tag="instagib" Click="OnTogglePlayerFlag" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,13" Margin="6,0,0,0">
                    <StackPanel>
                      <TextBlock Text="商店与旅行" FontSize="17" FontWeight="SemiBold" />
                      <WrapPanel Margin="0,10,0,0">
                        <CheckBox Content="免费商店" Tag="vendorCheat" Click="OnTogglePlayerFlag" Margin="0,0,16,0" />
                        <CheckBox Content="忽略装备需求" Tag="ignoreRequirements" Click="OnTogglePlayerFlag" Margin="0,0,16,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="解锁快速旅行" Click="OnUnlockFastTravel" Padding="10,6" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </Grid>
                <Border Style="{StaticResource Card}" Padding="16,13" IsEnabled="False">
                  <StackPanel>
                    <TextBlock Text="倍率与成长" FontSize="17" FontWeight="SemiBold" />
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="移动倍率" Foreground="{StaticResource MutedBrush}" FontSize="11" /><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBox x:Name="MoveSpeedBox" Width="58" Height="32" Padding="7,3" Text="1.5" /><Button Style="{StaticResource SecondaryButton}" Content="应用" Tag="movement" Click="OnWriteHeroMultiplier" Padding="8,6" Margin="5,0,0,0" /></StackPanel></StackPanel>
                      <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="经验倍率" Foreground="{StaticResource MutedBrush}" FontSize="11" /><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBox x:Name="ExperienceMultiplierBox" Width="58" Height="32" Padding="7,3" Text="3" /><Button Style="{StaticResource SecondaryButton}" Content="应用" Tag="experience" Click="OnWriteHeroMultiplier" Padding="8,6" Margin="5,0,0,0" /></StackPanel></StackPanel>
                      <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="属性点" Foreground="{StaticResource MutedBrush}" FontSize="11" /><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBox x:Name="AttributePointsBox" Width="58" Height="32" Padding="7,3" Text="10" /><Button Style="{StaticResource SecondaryButton}" Content="应用" Click="OnWriteAttributePoints" Padding="8,6" Margin="5,0,0,0" /></StackPanel></StackPanel>
                      <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock Text="目标等级" Foreground="{StaticResource MutedBrush}" FontSize="11" /><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBox x:Name="LevelBox" Width="58" Height="32" Padding="7,3" Text="30" /><Button Style="{StaticResource SecondaryButton}" Content="升级" Click="OnSetLevel" Padding="8,6" Margin="5,0,0,0" /></StackPanel></StackPanel>
                      <StackPanel Grid.Column="4"><TextBlock Text="最大属性等级" Foreground="{StaticResource MutedBrush}" FontSize="11" /><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBox x:Name="MaxStatsLevelBox" Width="58" Height="32" Padding="7,3" Text="30" /><Button Style="{StaticResource ActionButton}" Content="设置" Click="OnGiveMaxStats" Padding="8,6" Margin="5,0,0,0" /></StackPanel></StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <Grid x:Name="DetectorView" Visibility="Collapsed">
              <StackPanel>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="4 Bytes 数值变化探测器" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="适合属性点、装备等级、词条数或其它能明确看到整数变化的字段。它不修改游戏：先按初始值扫描，再让游戏内目标变化一次，最后按新值筛选。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Grid Margin="0,16,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="变化前" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="DetectorBeforeBox" Height="34" Padding="9,5" Text="10" Margin="0,7,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="变化后" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="DetectorAfterBox" Height="34" Padding="9,5" Text="11" Margin="0,7,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="18,0,0,0">
                        <Button Style="{StaticResource ActionButton}" Content="1. 初始扫描" Click="OnStartDetector" />
                        <Button Style="{StaticResource SecondaryButton}" Content="2. 按新值筛选" Click="OnFilterDetector" Margin="10,0,0,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="复制结果" Click="OnCopyDetectorReport" Margin="10,0,0,0" />
                      </StackPanel>
                    </Grid>
                    <TextBlock x:Name="DetectorStatusText" Text="先连接游戏，再填入游戏里当前可见的整数。" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="候选地址（最多展示 100 个）" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ListBox x:Name="DetectorResults" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MinHeight="260" />
                  </DockPanel>
                </Border>
              </StackPanel>
            </Grid>

            <Grid x:Name="LoadoutsView" Visibility="Collapsed">
              <StackPanel>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="本次版本的验证顺序" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="1. 备份存档并进入离线角色。  2. 概览页连接游戏，点击“检查已知定位”，必须显示三个入口均唯一匹配。  3. 角色页开启并读取角色上下文。  4. 先验证无限生命与货币。  5. 使用不重要的装备，开启物品捕获、在游戏详情页点它、读取后依次验证修满耐久、复制、改品质、加词条和模板创建。每一步都确认成功后再做下一步。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Text="当前版本保护" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="程序只接受当前 GameAssembly.dll 的 SHA-256 和三个唯一入口的组合校验；任一项不符就锁定所有写入。物品命令由游戏自己的 API 在角色更新线程上执行，不保存跨场景的地址。退出或断开时，所有临时入口补丁都会恢复。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBlock Text="未放入界面的功能：免费制作、无坠落伤害、全局攻速/伤害倍数。这些在当前构建中没有找到可安全验证的统一入口，因此没有做成可能误写的按钮。" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <Grid x:Name="LogsView" Visibility="Collapsed">
              <Border Style="{StaticResource Card}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="本次界面操作" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                  <ListBox x:Name="ActivityLog" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" />
                </DockPanel>
              </Border>
            </Grid>
        </Grid>
      </Grid>

      <Grid x:Name="GameLibraryPanel" Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Margin="18,14,14,14">
        <Grid.RowDefinitions><RowDefinition Height="250" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource AngularPanel}" Padding="0" ClipToBounds="True">
          <Grid>
            <Image Source="Assets/riftctrl-hero.png" Stretch="UniformToFill" Opacity="0.92" />
            <Rectangle Fill="{StaticResource HeroShadeBrush}" />
            <Rectangle Fill="#130E1536" Stroke="#5C37C8" StrokeThickness="1" StrokeDashArray="2,8" Margin="13" />
            <StackPanel Margin="34,25" VerticalAlignment="Center">
              <TextBlock FontFamily="Bahnschrift, Segoe UI" FontSize="39" FontWeight="SemiBold"><Run Text="RIFT" /><Run Text="//" Foreground="#B05AFF" /><Run Text="CTRL" /></TextBlock>
              <TextBlock Text="YOUR GAMES. YOUR RULES." FontFamily="Consolas" FontSize="13" Foreground="#D5DDF0" Margin="2,2,0,0" />
              <TextBlock x:Name="LibraryHeroSummaryText" Text="正在发现本机游戏…" FontSize="19" Foreground="#F5F7FF" Margin="0,25,0,0" />
              <TextBlock Text="STEAM  ·  EPIC  ·  LOCAL  ·  RIFT//CTRL READY" FontFamily="Consolas" FontSize="10" Foreground="#8AA2C7" Margin="0,9,0,0" />
              <Button Style="{StaticResource HeroButton}" Content="重新扫描游戏库    ›" Click="OnRefreshGameLibrary" Margin="0,17,0,0" HorizontalAlignment="Left" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="2,18,2,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="我的游戏库" FontSize="21" FontWeight="SemiBold" /><Border Background="#1C1042" BorderBrush="#7644E8" BorderThickness="1" CornerRadius="4" Padding="10,3" Margin="10,0,0,0"><TextBlock x:Name="LibraryCountBadge" Text="0" Foreground="#CEA7FF" FontSize="10" /></Border><Button Style="{StaticResource LibraryFilterButton}" Content="全部" Margin="18,0,0,0" /><Button Style="{StaticResource LibraryFilterButton}" Content="已支持" /><Button Style="{StaticResource LibraryFilterButton}" Content="暂未支持" /></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="排序：最近游戏" Foreground="#91A0B9" FontSize="10" Margin="0,0,11,0" /><Button Style="{StaticResource HeaderIconButton}" Content="&#xE8A9;" /></StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="InstalledGameLibraryList">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Button Tag="{Binding}" Click="OnLibraryGameClick" Style="{StaticResource GameCardButton}" Width="188" Height="278" Margin="0,0,14,14" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid ClipToBounds="True">
                  <Border x:Name="Shell" Background="#0A1322" BorderBrush="#25548D" BorderThickness="1" CornerRadius="6" />
                  <Grid Margin="1"><Grid.RowDefinitions><RowDefinition Height="190" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Image Source="{Binding IconPath}" Stretch="UniformToFill" Opacity="0.55" />
                    <Image Source="{Binding CoverArtPath}" Stretch="UniformToFill" />
                    <Rectangle Fill="#21030A18" />
                    <Border Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#E90A1020" BorderBrush="#89B0E3" BorderThickness="1" CornerRadius="4" Padding="7,3"><TextBlock Text="{Binding Platform}" FontSize="9" Foreground="#E9F3FF" /></Border>
                    <Border Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E908211A" BorderBrush="#228D63" BorderThickness="1" CornerRadius="4" Padding="7,3"><TextBlock Text="{Binding SupportLabel}" FontSize="9" Foreground="#65E8AB" /></Border>
                    <Grid Grid.Row="1" Background="#E908111F" Margin="0,-32,0,0"><Rectangle Fill="#9C050A17" /><StackPanel Margin="12,39,12,10"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" /><Grid Margin="0,8,0,0"><TextBlock Text="打开控制中心" FontSize="10" Foreground="#6CDAFF" /><TextBlock Text="›" FontSize="16" Foreground="#9B63FF" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></StackPanel></Grid>
                  </Grid>
                </Grid>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="LibraryStatusRail" Grid.Column="2" Grid.Row="1" Grid.RowSpan="2" Margin="0,14,18,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="260" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource AngularPanel}" Padding="18,16"><StackPanel><TextBlock Text="GAME LINK" Style="{StaticResource RailTitle}" /><Border Style="{StaticResource LinkRow}" Margin="0,14,0,0"><Grid><TextBlock Text="●  STEAM" FontSize="12" /><TextBlock x:Name="SteamLinkText" Text="扫描中" Foreground="#46E89B" HorizontalAlignment="Right" /></Grid></Border><Border Style="{StaticResource LinkRow}"><Grid><TextBlock Text="▣  EPIC" FontSize="12" /><TextBlock x:Name="EpicLinkText" Text="扫描中" Foreground="#46E89B" HorizontalAlignment="Right" /></Grid></Border><Border Style="{StaticResource LinkRow}"><Grid><TextBlock Text="▤  LOCAL" FontSize="12" /><TextBlock x:Name="LocalLinkText" Text="等待" Foreground="#46E89B" HorizontalAlignment="Right" /></Grid></Border><Border Background="#090F20" BorderBrush="#1F467D" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,12,0,0"><Grid><StackPanel><TextBlock x:Name="LibraryLinkSummaryText" Text="正在扫描游戏库…" Foreground="#85A2CB" FontSize="10" TextWrapping="Wrap" /><TextBlock Text="RIFT//CTRL CONFIGURATION" Foreground="#5E7CA4" FontSize="9" Margin="0,5,0,0" /></StackPanel><Grid Width="52" Height="52" HorizontalAlignment="Right"><Ellipse Stroke="#245C9A" StrokeThickness="1" /><Ellipse Width="34" Height="34" Stroke="#7F45FF" StrokeThickness="2" /><Ellipse Width="8" Height="8" Fill="#36DFFF" /></Grid></Grid></Border></StackPanel></Border>
        <Border Grid.Row="1" Style="{StaticResource AngularPanel}" Padding="18" Margin="0,14,0,0"><StackPanel><TextBlock Text="运行状态" Style="{StaticResource RailTitle}" /><Grid Height="150" Margin="0,12,0,0"><Ellipse Width="106" Height="106" Stroke="#1B477D" StrokeThickness="1" /><Ellipse Width="68" Height="68" Stroke="#2A6EB5" StrokeThickness="1" StrokeDashArray="3,4" /><Line X1="53" Y1="0" X2="53" Y2="150" Stroke="#1B477D" /><Line X1="0" Y1="75" X2="106" Y2="75" Stroke="#1B477D" /><Path Data="M53,40 L62,69 L53,63 L44,69 Z" Fill="#477FFF" /><TextBlock Text="未检测到运行中的游戏" Foreground="#9AAAC0" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Bottom" /></Grid><TextBlock Text="启动游戏后，RIFT//CTRL 将自动检测并准备适配的修改器。" Foreground="#617A9D" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Border>
        <Border Grid.Row="2" Style="{StaticResource AngularPanel}" Padding="18" Margin="0,14,0,0"><StackPanel><TextBlock Text="最近活动" Style="{StaticResource RailTitle}" /><Border Style="{StaticResource ActivityRow}" Margin="0,14,0,0"><Grid><TextBlock Text="游戏库扫描完成" /><TextBlock Text="刚刚" Foreground="#7690B2" HorizontalAlignment="Right" /></Grid></Border><Border Style="{StaticResource ActivityRow}"><Grid><TextBlock Text="RIFT//CTRL 界面已加载" /><TextBlock Text="本次会话" Foreground="#7690B2" HorizontalAlignment="Right" /></Grid></Border><Border Style="{StaticResource ActivityRow}"><Grid><TextBlock Text="本地模式已启用" /><TextBlock Text="安全" Foreground="#46E89B" HorizontalAlignment="Right" /></Grid></Border><Button Style="{StaticResource SecondaryButton}" Content="查看全部活动  ›" Margin="0,14,0,0" /></StackPanel></Border>
      </Grid>

      <Grid x:Name="ModifierStatusRail" Grid.Column="2" Grid.Row="1" Grid.RowSpan="2" Margin="0,14,18,14" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="220" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Style="{StaticResource AngularPanel}" Padding="18"><StackPanel><TextBlock Text="游戏状态" Style="{StaticResource RailTitle}" /><Grid Height="125" Margin="0,14,0,0"><Ellipse Width="104" Height="104" Stroke="#23578F" StrokeThickness="2" /><Ellipse Width="74" Height="74" Stroke="#7C45FF" StrokeThickness="2" StrokeDashArray="3,4" /><Ellipse Width="38" Height="38" Fill="#110D2B" Stroke="#3ED9FF" StrokeThickness="1" /><Path Data="M0,0 L0,13 L11,6.5 Z" Fill="#71DEFF" Stretch="Uniform" Width="14" Height="17" /><TextBlock x:Name="ModifierRailStateText" Text="等待连接" Foreground="#9DB6D4" FontSize="12" VerticalAlignment="Bottom" HorizontalAlignment="Center" /></Grid><TextBlock Text="请先启动游戏，再点击连接并验证。" Foreground="#6E86A8" FontSize="10" HorizontalAlignment="Center" /></StackPanel></Border>
        <Border Grid.Row="1" Style="{StaticResource AngularPanel}" Padding="18" Margin="0,14,0,0"><StackPanel><Grid><TextBlock Text="功能快捷列表" Style="{StaticResource RailTitle}" /><TextBlock Text="已验证模块" Foreground="#6C8DB6" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid><TextBox Text="⌕  搜索已启用功能" IsReadOnly="True" Height="36" Padding="11,5" Margin="0,14,0,0" /><Border Style="{StaticResource QuickFeatureRow}" Margin="0,10,0,0"><Grid><TextBlock Text="∞" Foreground="#66DFFF" FontSize="17" /><TextBlock Text="无限生命" Margin="29,0,0,0" /><Border HorizontalAlignment="Right" Background="#15233C" BorderBrush="#3A6394" BorderThickness="1" CornerRadius="3" Padding="7,2"><TextBlock Text="待连接" FontSize="9" Foreground="#A9C2DF" /></Border></Grid></Border><Border Style="{StaticResource QuickFeatureRow}"><Grid><TextBlock Text="◉" Foreground="#B779FF" FontSize="15" /><TextBlock Text="无限专注" Margin="29,0,0,0" /><Border HorizontalAlignment="Right" Background="#15233C" BorderBrush="#3A6394" BorderThickness="1" CornerRadius="3" Padding="7,2"><TextBlock Text="待连接" FontSize="9" Foreground="#A9C2DF" /></Border></Grid></Border><Border Style="{StaticResource QuickFeatureRow}"><Grid><TextBlock Text="ϟ" Foreground="#64DFFF" FontSize="17" /><TextBlock Text="无限体力" Margin="29,0,0,0" /><Border HorizontalAlignment="Right" Background="#15233C" BorderBrush="#3A6394" BorderThickness="1" CornerRadius="3" Padding="7,2"><TextBlock Text="待连接" FontSize="9" Foreground="#A9C2DF" /></Border></Grid></Border><Border Style="{StaticResource QuickFeatureRow}"><Grid><TextBlock Text="▣" Foreground="#65E8AB" FontSize="14" /><TextBlock Text="物品与模板" Margin="29,0,0,0" /><Border HorizontalAlignment="Right" Background="#15233C" BorderBrush="#3A6394" BorderThickness="1" CornerRadius="3" Padding="7,2"><TextBlock Text="需捕获" FontSize="9" Foreground="#A9C2DF" /></Border></Grid></Border></StackPanel></Border>
        <Border Grid.Row="2" Style="{StaticResource AngularPanel}" Padding="16" Margin="0,14,0,0"><StackPanel><TextBlock Text="连接流程" Style="{StaticResource RailTitle}" /><TextBlock Text="① 启动游戏   →   ② 连接验证   →   ③ 使用功能" Foreground="#83A2C8" FontSize="10" Margin="0,11,0,0" /></StackPanel></Border>
      </Grid>

      <Grid x:Name="UnsupportedGamePanel" Grid.Column="1" Grid.Row="2" Margin="24,16,24,16" Visibility="Collapsed">
        <Border Style="{StaticResource Card}" VerticalAlignment="Top" Padding="28,24">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="54" Height="54" Background="#1B1C23" BorderBrush="#2E3039" BorderThickness="1" CornerRadius="10">
              <Image Source="Assets/riftctrl-icon.png" Width="48" Height="48" />
            </Border>
            <StackPanel Grid.Column="1" Margin="17,0" VerticalAlignment="Center">
              <TextBlock x:Name="UnsupportedGameNameText" Text="正在读取已安装游戏" FontSize="21" FontWeight="SemiBold" />
              <TextBlock x:Name="UnsupportedGameDetailText" Text="正在扫描 Steam 与 Epic 游戏库…" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Column="2" Background="#1A1B21" BorderBrush="#30323B" BorderThickness="1" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
              <TextBlock x:Name="GameSupportBadgeText" Text="等待选择" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="SemiBold" />
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Border x:Name="ConnectionOverlay" Grid.Column="1" Grid.Row="2" Background="#E6030812" Visibility="Collapsed" IsHitTestVisible="True">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FA15161C" BorderBrush="#30323B" BorderThickness="1" CornerRadius="12" Padding="34,26">
          <StackPanel HorizontalAlignment="Center">
            <Grid Width="54" Height="54" HorizontalAlignment="Center">
              <Ellipse Stroke="#30323B" StrokeThickness="3" />
              <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="3" StrokeDashArray="3,5" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                <Ellipse.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360" Duration="0:0:0.9" />
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Ellipse.Triggers>
              </Ellipse>
              <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" />
            </Grid>
            <TextBlock Text="正在连接并验证" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,17,0,0" />
            <TextBlock x:Name="ConnectionProgressText" Text="正在查找游戏进程…" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0" />
          </StackPanel>
        </Border>
      </Border>

      <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" Background="#E9040914" BorderBrush="#153A67" BorderThickness="0,1,0,0" CornerRadius="0,0,8,0" Padding="18,8">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="{StaticResource NodeBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
          </StackPanel>
          <TextBlock Grid.Column="1" x:Name="ActionStatusText" Text="尚未连接游戏" Foreground="#9DA6B6" FontSize="11" Margin="2,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>
  </Grid>
  </Border>
</Window>
