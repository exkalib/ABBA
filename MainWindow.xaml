<Window x:Class="NRftWManagerUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RIFT//CTRL" Icon="Assets/riftctrl.ico" Height="520" Width="1120" MinHeight="500" MinWidth="980"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#05060B">
  <Border Background="{StaticResource SciFiGridBrush}" BorderBrush="#63438F" BorderThickness="1" CornerRadius="6">
  <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Canvas Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0.38">
        <Path Data="M0,110 L88,110 L124,74 L240,74" Stroke="#522A7A" StrokeThickness="1" />
        <Path Data="M1120,102 L1034,102 L1000,68 L900,68" Stroke="#2F79A1" StrokeThickness="1" />
        <Path Data="M0,500 L64,500 L92,472" Stroke="#44245F" StrokeThickness="1" />
        <Path Data="M1120,480 L1058,480 L1028,450" Stroke="#27566F" StrokeThickness="1" />
      </Canvas>

      <Border Grid.Row="0" Height="82" Padding="18,0,8,0" Background="{StaticResource HeaderGradient}" BorderBrush="#56377B" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0" MouseLeftButtonDown="OnTitleBarMouseDown">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Border Width="3" Height="48" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Margin="0,0,0,0">
            <Border.Effect><DropShadowEffect Color="#B450FF" BlurRadius="12" ShadowDepth="0" Opacity="0.85" /></Border.Effect>
          </Border>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="50" Height="50" Background="#100D19" BorderBrush="#6D3DA0" BorderThickness="1" CornerRadius="4" Margin="13,0,13,0">
              <Image Source="Assets/riftctrl-icon.png" Width="46" Height="46" Stretch="Uniform" />
            </Border>
            <StackPanel Width="130" VerticalAlignment="Center">
              <TextBlock x:Name="PageTitle" Text="RIFT//CTRL" FontFamily="Bahnschrift SemiCondensed, Segoe UI" FontSize="21" FontWeight="SemiBold" />
              <TextBlock x:Name="PageSubtitle" Text="GAME CONTROL SYSTEM" FontFamily="Consolas" FontSize="8" Foreground="#A47CC5" Margin="0,3,0,0" />
            </StackPanel>
            <Border Width="1" Height="40" Background="#3A3448" Margin="5,0,17,0" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="GameLibrarySummaryText" Text="正在扫描游戏库…" FontFamily="Consolas" Foreground="#778096" FontSize="8" Margin="2,0,0,5" />
              <ComboBox x:Name="GameSelector" Width="300" Height="35" Padding="10,4" DisplayMemberPath="DisplayName" SelectionChanged="OnGameSelectionChanged" MaxDropDownHeight="360" />
            </StackPanel>
            <Button x:Name="RefreshGameLibraryButton" Style="{StaticResource SecondaryButton}" Content="↻" Click="OnRefreshGameLibrary" Width="36" Height="35" Padding="0" Margin="7,15,0,0" ToolTip="重新扫描 Steam 和 Epic 游戏库" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
            <Border Background="#0A0D14" BorderBrush="#34394A" BorderThickness="1" CornerRadius="3" Padding="12,9" Margin="0,0,10,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ConnectionIndicator" Width="8" Height="8" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0">
                  <Ellipse.Effect><DropShadowEffect Color="#4DE7FF" BlurRadius="8" ShadowDepth="0" Opacity="0.7" /></Ellipse.Effect>
                </Ellipse>
                <TextBlock x:Name="ConnectionText" Text="未连接" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Button x:Name="ConnectButton" Style="{StaticResource ActionButton}" Click="OnConnectGame" Padding="16,9" IsEnabled="False">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ConnectSpinner" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeDashArray="2,2" Visibility="Collapsed" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                  <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                      <BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360" Duration="0:0:0.8" /></Storyboard></BeginStoryboard>
                    </EventTrigger>
                  </Ellipse.Triggers>
                </Ellipse>
                <TextBlock x:Name="ConnectButtonLabel" Text="连接游戏" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Content="—" Click="OnMinimizeWindow" Width="46" Background="Transparent" BorderThickness="0" Foreground="#91A4BC" FontSize="15" />
            <Button Content="×" Click="OnCloseWindow" Width="46" Background="Transparent" BorderThickness="0" Foreground="#91A4BC" FontSize="18" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}" Visibility="Collapsed">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="SYSTEM TELEMETRY" Style="{StaticResource MicroLabel}" />
              <TextBlock Text="实时状态" Style="{StaticResource SectionTitle}" FontSize="19" Margin="0,5,0,0" />
              <Rectangle Height="1" Fill="#36566A" Margin="0,13,0,0" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource TelemetryCard}" Margin="0,13,0,0">
              <StackPanel>
                <TextBlock Text="01 / RUNTIME" Style="{StaticResource MicroLabel}" />
                <TextBlock x:Name="RuntimeStateText" Text="未连接" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Margin="0,7,0,0" />
                <TextBlock x:Name="RuntimeDetailText" Text="等待游戏进程" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Row="2">
              <Border Style="{StaticResource TelemetryCard}" Margin="0,9,0,0">
                <StackPanel>
                  <TextBlock Text="02 / SIGNATURE" Style="{StaticResource MicroLabel}" />
                  <TextBlock x:Name="SignatureStateText" Text="等待扫描" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Margin="0,7,0,0" />
                  <TextBlock x:Name="SignatureDetailText" Text="当前构建特征码" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource TelemetryCard}" Margin="0,9,0,0">
                <StackPanel>
                  <TextBlock Text="03 / WRITE GATE" Style="{StaticResource MicroLabel}" />
                  <TextBlock x:Name="WriteStateText" Text="已锁定" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Margin="0,7,0,0" />
                  <TextBlock x:Name="WriteStateDetailText" Text="等待目标验证" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Grid.Row="4">
              <Rectangle Height="1" Fill="#29475A" Margin="0,0,0,12" />
              <TextBlock Text="OPERATOR NOTE" Style="{StaticResource MicroLabel}" Foreground="{StaticResource WarningBrush}" />
              <TextBlock Text="先在游戏中点击目标物品，再执行单项写入。界面只显示当前已验证模块。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0" />
              <TextBlock Text="BUILD 1.45 / NODE 01" FontFamily="Consolas" FontSize="9" Foreground="#49677A" Margin="0,15,0,0" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid x:Name="OperationSurface" Grid.Column="1" IsEnabled="False" Visibility="Collapsed" Margin="24,18,24,18">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Opacity" Value="1" />
              <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.34" /></Trigger></Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.RowDefinitions><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Width="2" HorizontalAlignment="Left" Margin="-9,48,0,8" Background="#6E36A3" Opacity="0.75" IsHitTestVisible="False">
              <Border.Effect><DropShadowEffect Color="#A855F7" BlurRadius="8" ShadowDepth="0" Opacity="0.7" /></Border.Effect>
            </Border>
            <Grid x:Name="OverviewView" Visibility="Collapsed" />

            <TabControl Grid.Row="0" SelectedIndex="2">
              <TabItem Header="物品修改">
                <Grid Margin="0,2,0,0" VerticalAlignment="Top">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Border Style="{StaticResource Card}" Padding="22,17" Margin="0,0,0,12" BorderBrush="#65418F">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <Border Width="44" Height="44" Background="#160F22" BorderBrush="#7543AB" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                        <Path Data="M12,8 H36 V40 H12 Z M18,15 H30 M18,22 H30 M18,29 H26" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Stretch="Uniform" Margin="12" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="当前物品" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <TextBlock x:Name="SelectedItemText" Text="尚未选择物品" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                      <Expander Grid.Column="2" Header="高级" IsExpanded="False" Foreground="#737D8F" VerticalAlignment="Center">
                        <StackPanel Width="300" Margin="0,8,0,0">
                          <ListBox x:Name="SelectedItemHistoryList" Height="72" FontFamily="Consolas" FontSize="11" />
                          <Button Style="{StaticResource SecondaryButton}" Content="复制诊断" Click="OnCopyItemNameDiagnostic" HorizontalAlignment="Right" Margin="0,7,0,0" />
                          <TextBox x:Name="ItemNameDiagnosticBox" Text="尚无物品名称诊断。" IsReadOnly="True" Visibility="Collapsed" />
                        </StackPanel>
                      </Expander>
                    </Grid>
                  </Border>

                  <Border Grid.Row="1" x:Name="ItemsView" Style="{StaticResource Card}" Padding="22,20">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,22,0">
                        <TextBlock Text="物品数量" Style="{StaticResource SectionTitle}" FontSize="17" />
                        <TextBlock x:Name="ItemCaptureText" Text="等待数量变化" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <Grid Margin="0,14,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <TextBox x:Name="ItemQuantityBox" MinWidth="110" Height="40" Padding="12,6" Text="20" FontSize="15" />
                          <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="写入数量" Click="OnWriteItemQuantity" Padding="15,9" Margin="9,0,0,0" />
                        </Grid>
                        <CheckBox x:Name="KeepLastItemCheck" Content="保留最后 1 个" IsChecked="True" Click="OnKeepLastItemChanged" Margin="0,13,0,0" />
                      </StackPanel>

                      <Border Grid.Column="1" Background="#2A303D" />
                      <StackPanel Grid.Column="2" Margin="22,0">
                        <TextBlock Text="品质" Style="{StaticResource SectionTitle}" FontSize="17" />
                        <TextBlock Text="直接应用到当前物品" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
                        <UniformGrid Columns="3" Margin="0,20,0,0">
                          <Button Style="{StaticResource RarityButton}" BorderBrush="#AFC3D1" Foreground="#EAF4F8" Content="白色" Tag="Common" Click="OnQueueRarity" Padding="10,8" Margin="0,0,5,0" />
                          <Button Style="{StaticResource RarityButton}" BorderBrush="#5AB8FF" Foreground="#8CCBFF" Content="蓝色" Tag="Magical" Click="OnQueueRarity" Padding="10,8" Margin="5,0" />
                          <Button Style="{StaticResource RarityButton}" BorderBrush="{StaticResource PurpleBrush}" Foreground="#F1ACFF" Content="紫色" Tag="Plagued" Click="OnQueueRarity" Padding="10,8" Margin="5,0,0,0" />
                        </UniformGrid>
                      </StackPanel>

                      <Border Grid.Column="3" Background="#2A303D" />
                      <StackPanel Grid.Column="4" Width="175" Margin="22,0,0,0">
                        <TextBlock Text="复制" Style="{StaticResource SectionTitle}" FontSize="17" />
                        <TextBlock Text="以当前物品为模板" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
                        <Button Style="{StaticResource ActionButton}" Content="复制当前物品" Click="OnCreateFromSelectedTemplate" HorizontalAlignment="Stretch" Margin="0,20,0,0" Padding="14,9" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </Grid>
              </TabItem>

              <TabItem Header="物品库">
                <Grid x:Name="EquipmentView" Margin="0,2,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>

                  <Border Style="{StaticResource Card}" Margin="0,0,7,0" Padding="24,22">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="物品库" Style="{StaticResource SectionTitle}" />
                          <TextBlock Text="从已保存模板中选择物品" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1B202C" CornerRadius="9" Padding="11,7" VerticalAlignment="Center">
                          <TextBlock x:Name="CapturedItemCatalogSummary" Text="等待物品数据" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </Border>
                      </Grid>
                      <Grid Grid.Row="1" Margin="0,18,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Path Data="M2,2 L12,12 M7,2 A5,5 0 1 0 7,12 A5,5 0 1 0 7,2" Stroke="#78849A" StrokeThickness="1.6" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1" x:Name="CapturedItemSearchBox" Height="42" Padding="12,7" TextChanged="OnFilterCapturedItems" ToolTip="输入中文名、内部路径或 GUID" />
                      </Grid>
                      <ListBox Grid.Row="2" x:Name="CapturedItemCatalogList" SelectionChanged="OnCapturedItemSelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="2,3">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="#EFF7FF" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Text="{Binding Metadata}" Visibility="Collapsed" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Grid>
                  </Border>

                  <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0" Padding="24,22">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <StackPanel>
                        <TextBlock Text="生成物品" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="以左侧选中模板创建新物品" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Row="1" Margin="0,28,0,0">
                        <TextBlock Text="物品名称" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        <TextBox x:Name="CapturedItemNameBox" Height="42" Padding="12,7" Margin="0,7,0,0" ToolTip="选中物品的中文名称" />
                        <TextBlock Text="生成数量" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,18,0,0" />
                        <TextBox x:Name="CatalogCreateCountBox" Height="42" Padding="12,7" Text="1" Margin="0,7,0,0" ToolTip="生成数量（1–99）" />
                        <Button Style="{StaticResource ActionButton}" Content="生成选中物品" Click="OnCreateFromCapturedTemplate" HorizontalAlignment="Stretch" Margin="0,16,0,0" />
                      </StackPanel>
                      <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="名称不正确时可直接修改" Foreground="#717B8C" FontSize="10" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="保存名称" Click="OnSaveCapturedItemName" Padding="12,7" />
                      </Grid>
                    </Grid>
                  </Border>

                  <Grid Visibility="Collapsed">
                    <TextBox x:Name="CreateItemCountBox" Text="1" />
                    <ComboBox x:Name="CreateItemRarityBox" SelectedIndex="0"><ComboBoxItem Content="Common（白）" /><ComboBoxItem Content="Magical（蓝）" /><ComboBoxItem Content="Plagued（紫）" /><ComboBoxItem Content="Gold（金）" /></ComboBox>
                    <TextBox x:Name="ItemLevelBox" Text="30" />
                  </Grid>
                </Grid>
              </TabItem>

              <TabItem Header="常规功能">
                <Grid Margin="0,2,0,0" VerticalAlignment="Top">
                  <Border Style="{StaticResource Card}" Padding="24,22">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="货币" Style="{StaticResource SectionTitle}" FontSize="18" />
                          <TextBlock x:Name="CurrencyCaptureText" Text="选择币种与增加数量" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,20,0">
                          <Button x:Name="CurrencyCopperButton" Style="{StaticResource SecondaryButton}" Content="铜币" Tag="Copper" Click="OnCurrencyClick" Padding="14,9" Margin="0,0,6,0" />
                          <Button x:Name="CurrencySilverButton" Style="{StaticResource SecondaryButton}" Content="银币" Tag="Silver" Click="OnCurrencyClick" Padding="14,9" Margin="0,0,6,0" />
                          <Button x:Name="CurrencyGoldButton" Style="{StaticResource SecondaryButton}" Content="金币" Tag="Gold" Click="OnCurrencyClick" Padding="14,9" Background="#8B7CFF" BorderBrush="#8B7CFF" Foreground="#FFFFFF" />
                        </StackPanel>
                        <TextBox Grid.Column="2" x:Name="CurrencyValueBox" MinWidth="130" Height="40" Padding="12,6" Text="1000" FontSize="15" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Style="{StaticResource ActionButton}" Content="增加货币" Click="OnWriteCurrency" Padding="17,9" Margin="9,0,0,0" VerticalAlignment="Center" />
                      </Grid>

                      <Border Grid.Row="1" Background="#2A303D" Margin="0,22" />

                      <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="生命与能量" Style="{StaticResource SectionTitle}" FontSize="18" />
                          <TextBlock Text="离开背包后持续保持" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource ControlCellGradient}" BorderBrush="#3B4050" BorderThickness="1" CornerRadius="4" Padding="14,13" Margin="8,0,6,0">
                          <Grid><TextBlock Text="无限生命" FontSize="13" VerticalAlignment="Center" /><CheckBox Tag="health" Click="OnToggleInfiniteStat" HorizontalAlignment="Right" /></Grid>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource ControlCellGradient}" BorderBrush="#3B4050" BorderThickness="1" CornerRadius="4" Padding="14,13" Margin="6,0">
                          <Grid><TextBlock Text="无限体力" FontSize="13" VerticalAlignment="Center" /><CheckBox Tag="stamina" Click="OnToggleInfiniteStat" HorizontalAlignment="Right" /></Grid>
                        </Border>
                        <Border Grid.Column="3" Background="{StaticResource ControlCellGradient}" BorderBrush="#3B4050" BorderThickness="1" CornerRadius="4" Padding="14,13" Margin="6,0,0,0">
                          <Grid><TextBlock Text="无限专注" FontSize="13" VerticalAlignment="Center" /><CheckBox Tag="focus" Click="OnToggleInfiniteStat" HorizontalAlignment="Right" /></Grid>
                        </Border>
                      </Grid>
                    </Grid>
                  </Border>
                </Grid>
              </TabItem>
            </TabControl>

            <Grid x:Name="CharacterView" Visibility="Collapsed">
              <StackPanel>
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,12">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="OPERATOR LINK / 04" Style="{StaticResource MicroLabel}" />
                      <TextBlock Text="角色与背包通道" Style="{StaticResource SectionTitle}" Margin="0,4,0,0" />
                      <TextBlock Text="角色参数仅做旁路捕获；危险的主动背包 API 测试已停用。" Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,3,0,0" />
                      <TextBlock Text="钱包捕获与写入已移到主页面。" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                      <Button Style="{StaticResource SecondaryButton}" Content="捕获角色参数" Click="OnStartCurrencyCapture" />
                      <Button x:Name="InventoryProbeButton" Style="{StaticResource SecondaryButton}" Content="开启背包旁路捕获" Click="OnProbeInventoryComponent" IsEnabled="False" Margin="8,0,0,0" />
                      <Button Style="{StaticResource SecondaryButton}" Content="复制诊断" Click="OnCopyPlayerDiagnostic" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBox x:Name="PlayerDiagnosticBox" Grid.Row="1" Grid.ColumnSpan="2" Text="尚无角色诊断数据。" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="68" Padding="8,6" Margin="0,10,0,0" />
                  </Grid>
                </Border>
                <Grid Margin="0,0,0,12" IsEnabled="False">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,6,0">
                    <StackPanel>
                      <TextBlock Text="生命与战斗" FontSize="17" FontWeight="SemiBold" />
                      <WrapPanel Margin="0,10,0,0">
                        <CheckBox Content="无限生命" Tag="health" Click="OnTogglePlayerFlag" Margin="0,0,16,0" />
                        <CheckBox Content="无限耐力" Tag="stamina" Click="OnTogglePlayerFlag" Margin="0,0,16,0" />
                        <CheckBox Content="无限专注" Tag="focus" Click="OnTogglePlayerFlag" Margin="0,0,16,0" />
                        <CheckBox Content="一击必杀" Tag="instagib" Click="OnTogglePlayerFlag" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,13" Margin="6,0,0,0">
                    <StackPanel>
                      <TextBlock Text="商店与旅行" FontSize="17" FontWeight="SemiBold" />
                      <WrapPanel Margin="0,10,0,0">
                        <CheckBox Content="免费商店" Tag="vendorCheat" Click="OnTogglePlayerFlag" Margin="0,0,16,0" />
                        <CheckBox Content="忽略装备需求" Tag="ignoreRequirements" Click="OnTogglePlayerFlag" Margin="0,0,16,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="解锁快速旅行" Click="OnUnlockFastTravel" Padding="10,6" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </Grid>
                <Border Style="{StaticResource Card}" Padding="16,13" IsEnabled="False">
                  <StackPanel>
                    <TextBlock Text="倍率与成长" FontSize="17" FontWeight="SemiBold" />
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="移动倍率" Foreground="{StaticResource MutedBrush}" FontSize="11" /><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBox x:Name="MoveSpeedBox" Width="58" Height="32" Padding="7,3" Text="1.5" /><Button Style="{StaticResource SecondaryButton}" Content="应用" Tag="movement" Click="OnWriteHeroMultiplier" Padding="8,6" Margin="5,0,0,0" /></StackPanel></StackPanel>
                      <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="经验倍率" Foreground="{StaticResource MutedBrush}" FontSize="11" /><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBox x:Name="ExperienceMultiplierBox" Width="58" Height="32" Padding="7,3" Text="3" /><Button Style="{StaticResource SecondaryButton}" Content="应用" Tag="experience" Click="OnWriteHeroMultiplier" Padding="8,6" Margin="5,0,0,0" /></StackPanel></StackPanel>
                      <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="属性点" Foreground="{StaticResource MutedBrush}" FontSize="11" /><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBox x:Name="AttributePointsBox" Width="58" Height="32" Padding="7,3" Text="10" /><Button Style="{StaticResource SecondaryButton}" Content="应用" Click="OnWriteAttributePoints" Padding="8,6" Margin="5,0,0,0" /></StackPanel></StackPanel>
                      <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock Text="目标等级" Foreground="{StaticResource MutedBrush}" FontSize="11" /><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBox x:Name="LevelBox" Width="58" Height="32" Padding="7,3" Text="30" /><Button Style="{StaticResource SecondaryButton}" Content="升级" Click="OnSetLevel" Padding="8,6" Margin="5,0,0,0" /></StackPanel></StackPanel>
                      <StackPanel Grid.Column="4"><TextBlock Text="最大属性等级" Foreground="{StaticResource MutedBrush}" FontSize="11" /><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBox x:Name="MaxStatsLevelBox" Width="58" Height="32" Padding="7,3" Text="30" /><Button Style="{StaticResource ActionButton}" Content="设置" Click="OnGiveMaxStats" Padding="8,6" Margin="5,0,0,0" /></StackPanel></StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <Grid x:Name="DetectorView" Visibility="Collapsed">
              <StackPanel>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="4 Bytes 数值变化探测器" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="适合属性点、装备等级、词条数或其它能明确看到整数变化的字段。它不修改游戏：先按初始值扫描，再让游戏内目标变化一次，最后按新值筛选。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Grid Margin="0,16,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="变化前" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="DetectorBeforeBox" Height="34" Padding="9,5" Text="10" Margin="0,7,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="变化后" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="DetectorAfterBox" Height="34" Padding="9,5" Text="11" Margin="0,7,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="18,0,0,0">
                        <Button Style="{StaticResource ActionButton}" Content="1. 初始扫描" Click="OnStartDetector" />
                        <Button Style="{StaticResource SecondaryButton}" Content="2. 按新值筛选" Click="OnFilterDetector" Margin="10,0,0,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="复制结果" Click="OnCopyDetectorReport" Margin="10,0,0,0" />
                      </StackPanel>
                    </Grid>
                    <TextBlock x:Name="DetectorStatusText" Text="先连接游戏，再填入游戏里当前可见的整数。" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="候选地址（最多展示 100 个）" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ListBox x:Name="DetectorResults" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MinHeight="260" />
                  </DockPanel>
                </Border>
              </StackPanel>
            </Grid>

            <Grid x:Name="LoadoutsView" Visibility="Collapsed">
              <StackPanel>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="本次版本的验证顺序" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="1. 备份存档并进入离线角色。  2. 概览页连接游戏，点击“检查已知定位”，必须显示三个入口均唯一匹配。  3. 角色页开启并读取角色上下文。  4. 先验证无限生命与货币。  5. 使用不重要的装备，开启物品捕获、在游戏详情页点它、读取后依次验证修满耐久、复制、改品质、加词条和模板创建。每一步都确认成功后再做下一步。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Text="当前版本保护" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="程序只接受当前 GameAssembly.dll 的 SHA-256 和三个唯一入口的组合校验；任一项不符就锁定所有写入。物品命令由游戏自己的 API 在角色更新线程上执行，不保存跨场景的地址。退出或断开时，所有临时入口补丁都会恢复。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBlock Text="未放入界面的功能：免费制作、无坠落伤害、全局攻速/伤害倍数。这些在当前构建中没有找到可安全验证的统一入口，因此没有做成可能误写的按钮。" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <Grid x:Name="LogsView" Visibility="Collapsed">
              <Border Style="{StaticResource Card}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="本次界面操作" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                  <ListBox x:Name="ActivityLog" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" />
                </DockPanel>
              </Border>
            </Grid>
        </Grid>
      </Grid>

      <Grid x:Name="UnsupportedGamePanel" Grid.Row="1" Margin="24,18,24,18">
        <Border Style="{StaticResource Card}" VerticalAlignment="Top" Padding="28,24">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="54" Height="54" Background="#120E1C" BorderBrush="#7344A6" BorderThickness="1" CornerRadius="4">
              <Image Source="Assets/riftctrl-icon.png" Width="48" Height="48" />
            </Border>
            <StackPanel Grid.Column="1" Margin="17,0" VerticalAlignment="Center">
              <TextBlock x:Name="UnsupportedGameNameText" Text="正在读取已安装游戏" FontSize="21" FontWeight="SemiBold" />
              <TextBlock x:Name="UnsupportedGameDetailText" Text="正在扫描 Steam 与 Epic 游戏库…" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Column="2" Background="#15101E" BorderBrush="#53346E" BorderThickness="1" CornerRadius="3" Padding="12,8" VerticalAlignment="Center">
              <TextBlock x:Name="GameSupportBadgeText" Text="等待选择" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="SemiBold" />
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Border x:Name="ConnectionOverlay" Grid.Row="1" Background="#B8060911" Visibility="Collapsed" IsHitTestVisible="True">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F30C0E16" BorderBrush="#7542A8" BorderThickness="1" CornerRadius="5" Padding="34,26">
          <StackPanel HorizontalAlignment="Center">
            <Grid Width="54" Height="54" HorizontalAlignment="Center">
              <Ellipse Stroke="#1D3950" StrokeThickness="3" />
              <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="3" StrokeDashArray="3,5" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                <Ellipse.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360" Duration="0:0:0.9" />
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Ellipse.Triggers>
              </Ellipse>
              <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" />
            </Grid>
            <TextBlock Text="正在连接并验证" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,17,0,0" />
            <TextBlock x:Name="ConnectionProgressText" Text="正在查找游戏进程…" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0" />
          </StackPanel>
        </Border>
      </Border>

      <Border Grid.Row="2" Background="#F0070910" BorderBrush="#4A315F" BorderThickness="0,1,0,0" CornerRadius="0,0,6,6" Padding="18,10">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="{StaticResource NodeBrush}" VerticalAlignment="Center" Margin="0,0,8,0">
              <Ellipse.Effect><DropShadowEffect Color="#4DE7FF" BlurRadius="9" ShadowDepth="0" Opacity="0.85" /></Ellipse.Effect>
            </Ellipse>
          </StackPanel>
          <TextBlock Grid.Column="1" x:Name="ActionStatusText" Text="尚未连接游戏" Foreground="#9DA6B6" FontSize="11" Margin="2,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>
  </Grid>
  </Border>
</Window>
