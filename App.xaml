<Application x:Class="NRftWManagerUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <System:Double xmlns:System="clr-namespace:System;assembly=System.Runtime" x:Key="{x:Static system:SystemParameters.VerticalScrollBarWidthKey}">7</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=System.Runtime" x:Key="{x:Static system:SystemParameters.HorizontalScrollBarHeightKey}">7</System:Double>
    <Color x:Key="VoidColor">#060812</Color>
    <Color x:Key="SurfaceColor">#0C1220</Color>
    <Color x:Key="SurfaceRaisedColor">#111B2D</Color>
    <Color x:Key="LineColor">#243753</Color>
    <Color x:Key="CyanColor">#38E8FF</Color>
    <Color x:Key="CyanSoftColor">#C2F8FF</Color>
    <Color x:Key="AmberColor">#EFBF72</Color>
    <Color x:Key="PurpleColor">#A990FF</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource VoidColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8292AC" />
    <SolidColorBrush x:Key="TextBrush" Color="#F4F8FF" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#0E6B7D" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}" />

    <LinearGradientBrush x:Key="SciFiGridBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#080B17" Offset="0" />
      <GradientStop Color="#070A13" Offset="0.52" />
      <GradientStop Color="#0B1020" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#F5111B2B" Offset="0" />
      <GradientStop Color="#F50B101C" Offset="0.72" />
      <GradientStop Color="#F20B1725" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="DisplayTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
      <Setter Property="FontWeight" Value="Light" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource DisplayTitle}">
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MicroLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="Background" Value="#D00B1119" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="#8036CFEA" />
      <Setter Property="BorderBrush" Value="#2A4260" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="InputShell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="InputShell" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="InputShell" Property="Effect"><Setter.Value><DropShadowEffect Color="#38E8FF" BlurRadius="10" ShadowDepth="0" Opacity="0.18" /></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="Background" Value="#0A1420" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="#31546C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#111C29" />
          <Setter Property="Foreground" Value="#536C80" />
          <Setter Property="Opacity" Value="1" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="#182437" BorderBrush="#36506D" BorderThickness="1" VerticalAlignment="Center">
                <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#7890A8" HorizontalAlignment="Left" Margin="3,0" />
              </Border>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#263FE5F7" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Knob" Property="Effect"><Setter.Value><DropShadowEffect Color="#38E8FF" BlurRadius="8" ShadowDepth="0" Opacity="0.75" /></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#A6080D18" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="#243853" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="7" />
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="9,6" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#4930AFC3" />
          <Setter Property="Foreground" Value="#FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelGradient}" />
      <Setter Property="BorderBrush" Value="#263B58" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Effect">
        <Setter.Value><DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="9" Opacity="0.42" /></Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TelemetryCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="13,11" />
      <Setter Property="Background" Value="#E00C121A" />
      <Setter Property="BorderBrush" Value="#1E2A35" />
    </Style>

    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Background" Value="#38E8FF" />
      <Setter Property="Foreground" Value="#061018" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Glow" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" />
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Glow" Property="Background" Value="#78F2FF" />
                <Setter TargetName="Glow" Property="Effect"><Setter.Value><DropShadowEffect Color="#38E8FF" BlurRadius="20" ShadowDepth="0" Opacity="0.48" /></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Glow" Property="Background" Value="#20BFD6" /></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#526A7B" />
                <Setter Property="BorderBrush" Value="#233847" />
                <Setter TargetName="Glow" Property="Background" Value="#0C1621" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#152238" />
      <Setter Property="BorderBrush" Value="#315070" />
      <Setter Property="Foreground" Value="#E5F0FF" />
    </Style>

    <Style x:Key="RarityButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="7" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Opacity" Value="0.42" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" /></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Background="#38E8FF"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="1,4" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" /></Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.92" /></Trigger>
        <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="7" /></Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
