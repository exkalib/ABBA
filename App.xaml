<Application x:Class="NRftWManagerUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Color x:Key="VoidColor">#05070B</Color>
    <Color x:Key="SurfaceColor">#0A0F16</Color>
    <Color x:Key="SurfaceRaisedColor">#101721</Color>
    <Color x:Key="LineColor">#202C39</Color>
    <Color x:Key="CyanColor">#71E3DC</Color>
    <Color x:Key="CyanSoftColor">#B4FFF9</Color>
    <Color x:Key="AmberColor">#EFBF72</Color>
    <Color x:Key="PurpleColor">#A990FF</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource VoidColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="#7F8D9B" />
    <SolidColorBrush x:Key="TextBrush" Color="#F1F5F7" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#174B4A" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}" />

    <LinearGradientBrush x:Key="SciFiGridBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#05070B" Offset="0" />
      <GradientStop Color="#080D14" Offset="0.48" />
      <GradientStop Color="#070A10" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#F2101720" Offset="0" />
      <GradientStop Color="#F00A0E14" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="DisplayTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
      <Setter Property="FontWeight" Value="Light" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource DisplayTitle}">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MicroLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="Background" Value="#D00B1119" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="#8036CFEA" />
      <Setter Property="BorderBrush" Value="#2A3A49" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="Background" Value="#0A1420" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="#31546C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#111C29" />
          <Setter Property="Foreground" Value="#536C80" />
          <Setter Property="Opacity" Value="1" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#A8060A10" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="#1D2934" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="7" />
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="9,6" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#352E8F8B" />
          <Setter Property="Foreground" Value="#FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelGradient}" />
      <Setter Property="BorderBrush" Value="#202D39" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Effect">
        <Setter.Value><DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="8" Opacity="0.32" /></Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TelemetryCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="13,11" />
      <Setter Property="Background" Value="#E00C121A" />
      <Setter Property="BorderBrush" Value="#1E2A35" />
    </Style>

    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Background" Value="#243C3D" />
      <Setter Property="Foreground" Value="#F1FFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="17,9" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Glow" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" />
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Glow" Property="Background" Value="#315857" />
                <Setter TargetName="Glow" Property="Effect"><Setter.Value><DropShadowEffect Color="#71E3DC" BlurRadius="16" ShadowDepth="0" Opacity="0.24" /></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Glow" Property="Background" Value="#3D6E6B" /></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#526A7B" />
                <Setter Property="BorderBrush" Value="#233847" />
                <Setter TargetName="Glow" Property="Background" Value="#0C1621" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#111923" />
      <Setter Property="BorderBrush" Value="#2B3946" />
      <Setter Property="Foreground" Value="#D4DCE2" />
    </Style>

    <Style x:Key="RarityButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" /></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Background="#3A565D"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="3" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" /></Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
