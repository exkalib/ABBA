<Window x:Class="NRftWManagerUI.DemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RIFT//CTRL" Icon="Assets/riftctrl.ico" Width="1536" Height="1024" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Background="#02070D">
  <Window.Resources>
    <Style x:Key="FramePanel" TargetType="Border">
      <Setter Property="Background"><Setter.Value><ImageBrush ImageSource="Assets/ui-frame-panel-wide.png" Stretch="Fill"/></Setter.Value></Setter><Setter Property="Padding" Value="16" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="TopButton" TargetType="Button"><Setter Property="Foreground" Value="#C9DBF5"/><Setter Property="Background"><Setter.Value><ImageBrush ImageSource="Assets/ui-button-secondary-shell.png" Stretch="Fill"/></Setter.Value></Setter><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,7"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="NavButton" TargetType="Button"><Setter Property="Foreground" Value="#9DAAC0"/><Setter Property="Height" Value="67"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="18,9"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="16"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Image x:Name="HoverFrame" Source="Assets/menu-hover-frame.png" Stretch="Fill" Opacity="0"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverFrame" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="HoverFrame" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="ActiveNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="Foreground" Value="#EEF3FF"/><Setter Property="Height" Value="73"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Image Source="Assets/menu-active-frame.png" Stretch="Fill" Margin="-2,0,-5,0"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource TopButton}"><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="FontSize" Value="13"/></Style>
    <Style x:Key="GameButton" TargetType="Button"><Setter Property="Background" Value="#071321"/><Setter Property="BorderBrush" Value="#215684"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="SocialButton" TargetType="Button"><Setter Property="Foreground" Value="#7894C0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="18"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#7F9CFF"/></Trigger></Style.Triggers></Style>
    <Style x:Key="SidebarCardButton" TargetType="Button"><Setter Property="Foreground" Value="#C9DBF5"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Image x:Name="CardFrame" Source="Assets/ui-frame-panel-wide.png" Stretch="Fill" Opacity="0.58"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardFrame" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="CardFrame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Viewbox Stretch="Fill"><Grid Width="1536" Height="1024">
    <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="868"/><ColumnDefinition Width="416"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="894"/><RowDefinition Height="48"/></Grid.RowDefinitions>
    <Rectangle Grid.RowSpan="3" Grid.ColumnSpan="3" Fill="#02070D"/>
    <Rectangle Grid.RowSpan="3" Grid.ColumnSpan="3" Fill="{StaticResource TechGridBrush}" Opacity="0.24"/>
    <Image Grid.Column="0" Grid.Row="1" Source="Assets/ui-decoration-lines.png" Width="252" Height="223" VerticalAlignment="Bottom" Stretch="Fill" Opacity="0.5" IsHitTestVisible="False"/>

    <Border Grid.RowSpan="3" Background="#ED040914" BorderBrush="#173C69" BorderThickness="0,0,1,0">
      <Grid>
        <Image Source="Assets/menu-rail-edges.png" Width="252" Height="1010" Stretch="Fill" Opacity="0.36" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"/>
        <Image Source="Assets/menu-rail-frame.png" Width="252" Height="870" Stretch="Fill" Opacity="0.36" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"/>
        <Grid Margin="18,16"><Grid.RowDefinitions><RowDefinition Height="91"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="-3,18,0,0"><Image Source="Assets/ui-riftctrl-wordmark.png" Width="206" Height="29" HorizontalAlignment="Left"/><TextBlock Text="YOUR GAMES. YOUR RULES." FontFamily="Consolas" FontSize="10" Foreground="#9FB4D2" Margin="2,3,0,0"/></StackPanel>
        <StackPanel Grid.Row="1">
          <Button Style="{StaticResource ActiveNavButton}" Click="OnNavClick" Tag="游戏库"><StackPanel Orientation="Horizontal"><Image Source="Assets/menu-icon-active-01.png" Width="30" Height="30" Margin="4,0,15,0"/><StackPanel><TextBlock Text="游戏库" FontWeight="SemiBold"/><TextBlock Text="37 款游戏已发现" FontSize="11" Foreground="#8397B6" Margin="0,3,0,0"/></StackPanel></StackPanel></Button>
          <Button Style="{StaticResource NavButton}" Click="OnNavClick" Tag="修改器中心"><StackPanel Orientation="Horizontal"><Image Source="Assets/menu-icon-idle-02.png" Width="30" Height="30" Margin="4,0,15,0"/><StackPanel><TextBlock Text="修改器中心"/><TextBlock Text="16 款游戏已支持" FontSize="11" Foreground="#8397B6" Margin="0,3,0,0"/></StackPanel></StackPanel></Button>
          <Button Style="{StaticResource NavButton}" Click="OnNavClick" Tag="配置方案"><StackPanel Orientation="Horizontal"><Image Source="Assets/menu-icon-idle-03.png" Width="30" Height="30" Margin="4,0,15,0"/><StackPanel><TextBlock Text="配置方案"/><TextBlock Text="我的配置方案" FontSize="11" Foreground="#8397B6" Margin="0,3,0,0"/></StackPanel></StackPanel></Button>
          <Button Style="{StaticResource NavButton}" Click="OnNavClick" Tag="热键管理"><StackPanel Orientation="Horizontal"><Image Source="Assets/menu-icon-idle-04.png" Width="30" Height="30" Margin="4,0,15,0"/><StackPanel><TextBlock Text="热键管理"/><TextBlock Text="全局热键设置" FontSize="11" Foreground="#8397B6" Margin="0,3,0,0"/></StackPanel></StackPanel></Button>
          <Button Style="{StaticResource NavButton}" Click="OnNavClick" Tag="扩展工具"><StackPanel Orientation="Horizontal"><Image Source="Assets/menu-icon-idle-05.png" Width="30" Height="30" Margin="4,0,15,0"/><StackPanel><TextBlock Text="扩展工具"/><TextBlock Text="脚本 &amp; 工具" FontSize="11" Foreground="#8397B6" Margin="0,3,0,0"/></StackPanel></StackPanel></Button>
          <Button Style="{StaticResource NavButton}" Click="OnNavClick" Tag="设置"><StackPanel Orientation="Horizontal"><Image Source="Assets/menu-icon-idle-06.png" Width="30" Height="30" Margin="4,0,15,0"/><StackPanel><TextBlock Text="设置"/><TextBlock Text="界面 &amp; 其他" FontSize="11" Foreground="#8397B6" Margin="0,3,0,0"/></StackPanel></StackPanel></Button>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,32">
          <Image Source="Assets/menu-radar.png" Width="216" Height="195" HorizontalAlignment="Center" Stretch="Fill"><Image.RenderTransform><TranslateTransform Y="-10"/></Image.RenderTransform></Image>
          <Grid Height="68" Margin="12,0"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,9,0,-9"><TextBlock Text="RIFT CORE" Foreground="#77D7FF" FontSize="14" HorizontalAlignment="Center"/><TextBlock Text="v2.0.0" Foreground="#8298BA" Margin="0,9,0,0" HorizontalAlignment="Center"/></StackPanel></Grid>
          <Button Style="{StaticResource SidebarCardButton}" Height="68" Padding="0,0,17,0" Margin="10,13,18,0" Click="OnHeaderClick" Tag="RIFT//CTRL PRO"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><Image Source="Assets/menu-pro-icon.png" Width="30" Height="30" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="RIFT//CTRL PRO" Foreground="#C7E9FF"/><TextBlock Text="永久授权" Foreground="#38D89A" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="⊙" Foreground="#29E280" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Button>
          <Grid Height="50" Margin="11,11,18,0"><Image Source="Assets/ui-frame-panel-wide.png" Stretch="Fill" Opacity="0.58" Margin="-1,0,1,0"/><UniformGrid Columns="4" Margin="10,5,-17,5"><Button Style="{StaticResource SocialButton}" Click="OnHeaderClick" Tag="社区"><Image Source="Assets/menu-social-01.png" Width="24" Height="24"/></Button><Button Style="{StaticResource SocialButton}" Click="OnHeaderClick" Tag="好友"><Image Source="Assets/menu-social-02.png" Width="24" Height="24"/></Button><Button Style="{StaticResource SocialButton}" Click="OnHeaderClick" Tag="媒体"><Image Source="Assets/menu-social-03.png" Width="24" Height="24"/></Button><Button Style="{StaticResource SocialButton}" Click="OnHeaderClick" Tag="分享"><Image Source="Assets/menu-social-04.png" Width="24" Height="24"/></Button></UniformGrid></Grid>
        </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Column="1" Grid.ColumnSpan="2" Background="#ED040914" BorderBrush="#173C69" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown"><Grid Margin="42,0,22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBox x:Name="SearchBox" Width="290" Height="40" Padding="18,4" Foreground="#C8D9EF" Background="#081526" BorderBrush="#1C4E87" TextChanged="OnSearchChanged" ToolTip="搜索游戏（支持拼音）"/><Button Style="{StaticResource TopButton}" Content="⟳  重新扫描" Margin="18,0,0,0" Click="OnRefreshClick"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource TopButton}" Content="♧" Click="OnHeaderClick" Tag="通知"/><Button Style="{StaticResource TopButton}" Content="〉_" Margin="8,0,28,0" Click="OnHeaderClick" Tag="终端"/><Border Style="{StaticResource FramePanel}" Padding="8,5"><StackPanel Orientation="Horizontal"><Image Source="Assets/riftctrl-icon.png" Width="34" Height="34"/><TextBlock Text="RIFT-USER" VerticalAlignment="Center" Margin="8,0,0,0"/><Border Background="#7737E8" Padding="5,2" Margin="8,7,0,7"><TextBlock Text="PRO" FontSize="10"/></Border></StackPanel></Border><Button Style="{StaticResource TopButton}" Content="—" Margin="24,0,0,0" Click="OnWindowClick" Tag="min"/><Button Style="{StaticResource TopButton}" Content="□" Margin="4,0,0,0" Click="OnWindowClick" Tag="max"/><Button Style="{StaticResource TopButton}" Content="×" Margin="4,0,0,0" Click="OnWindowClick" Tag="close"/></StackPanel></Grid></Border>

    <Grid Grid.Column="1" Grid.Row="1" Margin="26,0,18,14"><Grid.RowDefinitions><RowDefinition Height="252"/><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource FramePanel}" Padding="0"><Grid><Image Source="Assets/riftctrl-hero.png" Stretch="UniformToFill" Opacity="0.88"/><Rectangle Fill="#91020A18"/><StackPanel Margin="36,31" VerticalAlignment="Center"><TextBlock FontFamily="Bahnschrift" FontSize="38" FontWeight="Bold"><Run Text="RIFT"/><Run Text="//" Foreground="#A758FF"/><Run Text="CTRL"/></TextBlock><TextBlock Text="YOUR GAMES. YOUR RULES." FontFamily="Consolas" FontSize="14" Foreground="#D4E1F4"/><TextBlock Text="已发现 37 款本机游戏" FontSize="20" Margin="0,29,0,0"/><TextBlock Text="STEAM  24  ·  EPIC  9  ·  LOCAL  4" Foreground="#A0B3CC" Margin="0,8,0,0"/><Button Style="{StaticResource TopButton}" Content="进入游戏库     ›" Width="170" Margin="0,21,0,0" HorizontalAlignment="Left" Click="OnHeroClick"/></StackPanel></Grid></Border>
      <Grid Grid.Row="1" Margin="8,18,8,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="我的游戏库 (37)" FontSize="20" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0"><Button Style="{StaticResource ChipButton}" Content="全部 (37)" Click="OnFilterClick" Tag="全部"/><Button Style="{StaticResource ChipButton}" Content="已支持 (16)" Click="OnFilterClick" Tag="已支持"/><Button Style="{StaticResource ChipButton}" Content="暂未支持 (17)" Click="OnFilterClick" Tag="暂未支持"/><TextBlock Text="排序： 最近游玩⌄" Foreground="#9BAFCC" VerticalAlignment="Center" Margin="250,0,12,0"/><Button Style="{StaticResource TopButton}" Content="▦" Click="OnViewClick" Tag="网格"/><Button Style="{StaticResource TopButton}" Content="☷" Margin="6,0,0,0" Click="OnViewClick" Tag="列表"/></StackPanel></Grid>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="GamesList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource GameButton}" Width="192" Height="188" Margin="0,0,12,14" Tag="{Binding}" Click="OnGameClick"><Grid><Image Source="{Binding Cover}" Height="118" VerticalAlignment="Top" Stretch="UniformToFill"/><Rectangle VerticalAlignment="Bottom" Height="70" Fill="#D9040914"/><StackPanel VerticalAlignment="Bottom" Margin="14,0,14,11"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><Grid Margin="0,8,0,0"><Border Background="#0B2B33" BorderBrush="#197D8D" BorderThickness="1" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="已支持" FontSize="10" Foreground="#5DE2EF"/></Border><TextBlock Text="{Binding Features}" HorizontalAlignment="Right" Foreground="#A8B7CD" FontSize="11" VerticalAlignment="Center"/></Grid></StackPanel></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Grid>

    <Grid Grid.Column="2" Grid.Row="1" Margin="0,0,20,14"><Grid.RowDefinitions><RowDefinition Height="282"/><RowDefinition Height="272"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource FramePanel}"><StackPanel><TextBlock Text="GAME LINK  ?" Foreground="#9BD9FF" FontSize="18" FontWeight="SemiBold"/><Button Style="{StaticResource TopButton}" Content="◉  STEAM                                      已连接  ●" HorizontalContentAlignment="Left" Margin="0,15,0,0" Click="OnLinkClick" Tag="Steam"/><Button Style="{StaticResource TopButton}" Content="▣  EPIC                                        已连接  ●" HorizontalContentAlignment="Left" Margin="0,8,0,0" Click="OnLinkClick" Tag="Epic"/><Button Style="{StaticResource TopButton}" Content="▤  LOCAL                                     扫描完成  ●" HorizontalContentAlignment="Left" Margin="0,8,0,0" Click="OnLinkClick" Tag="Local"/><Border Background="#091526" BorderBrush="#1E548F" BorderThickness="1" Padding="12" Margin="0,14,0,0"><Grid><StackPanel><TextBlock Text="检测到 37 款游戏" Foreground="#A7C0DD"/><TextBlock Text="其中 16 款已有 RIFT//CTRL 配置" Foreground="#7F98BA" Margin="0,5,0,0"/></StackPanel><Ellipse Width="72" Height="72" Stroke="#6F3CFF" StrokeThickness="2" HorizontalAlignment="Right"/></Grid></Border></StackPanel></Border>
      <Border Grid.Row="1" Style="{StaticResource FramePanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="运行状态" Foreground="#9BD9FF" FontSize="18" FontWeight="SemiBold"/><Grid Height="150" Margin="0,18,0,0"><Ellipse Width="98" Height="98" Stroke="#245C9A"/><Ellipse Width="58" Height="58" Stroke="#2D73B6" StrokeDashArray="3,4"/><Line X1="49" Y1="0" X2="49" Y2="128" Stroke="#245C9A"/><Line X1="0" Y1="64" X2="98" Y2="64" Stroke="#245C9A"/></Grid><TextBlock x:Name="RunStateText" Text="未检测到运行中的游戏" HorizontalAlignment="Center" Foreground="#B4C4D8"/><TextBlock Text="启动游戏后，RIFT//CTRL 将自动检测并准备适配的修改器。" TextAlignment="Center" TextWrapping="Wrap" Foreground="#768EAF" Margin="12,8,12,0"/></StackPanel></Border>
      <Border Grid.Row="2" Style="{StaticResource FramePanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="最近活动" Foreground="#9BD9FF" FontSize="18" FontWeight="SemiBold"/><Button Style="{StaticResource TopButton}" Content="《艾尔登法环》  修改器已应用                          2 小时前" HorizontalContentAlignment="Left" Margin="0,18,0,0" Click="OnActivityClick"/><Button Style="{StaticResource TopButton}" Content="《赛博朋克 2077》  修改器已应用                         昨天" HorizontalContentAlignment="Left" Margin="0,7,0,0" Click="OnActivityClick"/><Button Style="{StaticResource TopButton}" Content="《GTA 5》  修改器配置已更新                            2 天前" HorizontalContentAlignment="Left" Margin="0,7,0,0" Click="OnActivityClick"/><Button Style="{StaticResource TopButton}" Content="查看全部活动     ›" Margin="0,16,0,0" Click="OnActivityClick"/></StackPanel></Border>
    </Grid>
    <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" BorderBrush="#1E548F" BorderThickness="0,1,0,0" Background="#DF040914"><Grid Margin="24,0"><TextBlock x:Name="DemoStatus" Text="SYSTEM ONLINE    ●    SECURE CORE    ●    UP TO DATE" Foreground="#55D89C" VerticalAlignment="Center"/><TextBlock Text="RIFT//CTRL PRO  ·  连接稳定  ▂▅█" Foreground="#8FA9C7" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
  </Grid></Viewbox>
</Window>
